@page "/Account/InvalidPasswordReset"

<PageTitle>Ogiltig återställningslänk | EasySystems</PageTitle>

<div class="booking-auth-page auth-invalid-password-reset-page">
    <section class="booking-auth-card">
        <div class="booking-auth-brand">
            <div class="booking-auth-logo">ES</div>
            <div>
                <strong>EasySystems</strong>
                <span>Password recovery</span>
            </div>
        </div>

        <div class="booking-auth-icon is-error">
            !
        </div>

        <div class="booking-auth-header">
            <p class="booking-auth-eyebrow">Ogiltig länk</p>
            <h1>Länken fungerar inte längre</h1>
            <p role="alert">
                Återställningslänken är ogiltig eller har gått ut. Begär en ny länk för att fortsätta säkert.
            </p>
        </div>

        <div class="booking-auth-actions">
            <a class="booking-auth-primary-link" href="/Account/ForgotPassword">
                Begär ny återställningslänk
            </a>

            <a class="booking-auth-secondary-link" href="/Account/Login">
                Tillbaka till inloggning
            </a>
        </div>
    </section>

    <aside class="booking-auth-side">
        <div class="booking-auth-glow"></div>

        <div class="booking-auth-side-content">
            <span class="booking-auth-badge">Security first</span>
            <h2>För din säkerhet slutar gamla länkar att fungera.</h2>
            <p>
                Skapa en ny återställningslänk så kan du välja ett nytt lösenord och komma tillbaka till ditt konto.
            </p>
        </div>
    </aside>
</div>