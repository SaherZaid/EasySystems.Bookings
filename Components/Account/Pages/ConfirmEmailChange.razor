@page "/Account/ConfirmEmailChange"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using EasySystems.Bookings.Data.Entities

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Bekräfta ny e-post | EasySystems</PageTitle>

<div class="booking-auth-page clean-auth-page">
    <section class="booking-auth-card">
        <div class="booking-auth-brand">
            <div class="booking-auth-logo">ES</div>
            <div>
                <strong>EasySystems</strong>
                <span>Email change</span>
            </div>
        </div>

        <StatusMessage Message="@message" />

        <div class="booking-auth-icon @statusClass">@statusIcon</div>

        <div class="booking-auth-header">
            <p class="booking-auth-eyebrow">@statusLabel</p>
            <h1>@headline</h1>
            <p>@description</p>
        </div>

        <div class="booking-auth-actions">
            <a class="booking-auth-primary-link" href="/Account/Manage">
                Till kontoinställningar
            </a>

            <a class="booking-auth-secondary-link" href="/Account/Login">
                Gå till inloggning
            </a>
        </div>
    </section>

    <section class="booking-auth-visual">
        <div>
            <span>EasySystems</span>
            <h2>Account updated.</h2>
            <p>Your account details stay protected with secure verification.</p>
        </div>
    </section>
</div>

@code {
    private string? message;
    private string statusLabel = "Kontrollerar";
    private string headline = "Bekräftar din nya e-post";
    private string description = "Vänta medan vi uppdaterar ditt konto.";
    private string statusIcon = "⏳";
    private string statusClass = "is-loading";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Email is null || Code is null)
        {
            RedirectManager.RedirectToWithStatus(
                "Account/Login",
                "Fel: Ogiltig länk för att bekräfta ny e-post.",
                HttpContext);
            return;
        }

        var user = await UserManager.FindByIdAsync(UserId);

        if (user is null)
        {
            SetError("Kontot hittades inte", "Vi kunde inte hitta kontot som hör till länken.");
            message = "Fel: användaren kunde inte hittas.";
            return;
        }

        var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        var result = await UserManager.ChangeEmailAsync(user, Email, code);

        if (!result.Succeeded)
        {
            SetError("E-posten kunde inte ändras", "Länken kan vara ogiltig eller ha gått ut.");
            message = "Fel: e-posten kunde inte ändras.";
            return;
        }

        var setUserNameResult = await UserManager.SetUserNameAsync(user, Email);

        if (!setUserNameResult.Succeeded)
        {
            SetError("Användarnamnet kunde inte uppdateras", "E-posten ändrades, men användarnamnet kunde inte synkas.");
            message = "Fel: användarnamnet kunde inte uppdateras.";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);

        statusLabel = "Klart";
        headline = "Din nya e-post är bekräftad";
        description = "Din e-postadress har uppdaterats.";
        message = "Tack för att du bekräftade din nya e-post.";
        statusIcon = "✓";
        statusClass = "is-success";
    }

    private void SetError(string newHeadline, string newDescription)
    {
        statusLabel = "Något gick fel";
        headline = newHeadline;
        description = newDescription;
        statusIcon = "!";
        statusClass = "is-error";
    }
}