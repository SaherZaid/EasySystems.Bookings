@page "/Account/ForgotPasswordConfirmation"

<PageTitle>E-post skickad | EasySystems</PageTitle>

<div class="booking-auth-page auth-forgot-password-confirmation-page">
    <section class="booking-auth-card">
        <div class="booking-auth-brand">
            <div class="booking-auth-logo">ES</div>
            <div>
                <strong>EasySystems</strong>
                <span>Password recovery</span>
            </div>
        </div>

        <div class="booking-auth-icon is-success">
            ✓
        </div>

        <div class="booking-auth-header">
            <p class="booking-auth-eyebrow">Kontrollera din e-post</p>
            <h1>Återställningslänk skickad</h1>
            <p>
                Om det finns ett konto med den e-postadressen har vi skickat en länk för att återställa lösenordet.
                Kontrollera inkorgen och även skräpposten.
            </p>
        </div>

        <div class="booking-auth-actions">
            <a class="booking-auth-primary-link" href="/Account/Login">
                Tillbaka till inloggning
            </a>

            <a class="booking-auth-secondary-link" href="/Account/Register">
                Skapa konto
            </a>
        </div>
    </section>

    <aside class="booking-auth-side">
        <div class="booking-auth-glow"></div>

        <div class="booking-auth-side-content">
            <span class="booking-auth-badge">Almost there</span>
            <h2>Öppna din e-post och fortsätt säkert.</h2>
            <p>
                Följ länken vi skickade och skapa ett nytt lösenord för att komma tillbaka till ditt konto.
            </p>

            <div class="booking-auth-timeline">
                <div>
                    <strong>1</strong>
                    <span>Kontrollera din inkorg</span>
                </div>
                <div>
                    <strong>2</strong>
                    <span>Klicka på återställningslänken</span>
                </div>
                <div>
                    <strong>3</strong>
                    <span>Skapa ditt nya lösenord</span>
                </div>
            </div>
        </div>
    </aside>
</div>