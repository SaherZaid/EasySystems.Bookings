@page "/Account/AccessDenied"

<PageTitle>Åtkomst nekad | EasySystems</PageTitle>

<div class="booking-auth-page clean-auth-page">
    <section class="booking-auth-card">
        <div class="booking-auth-brand">
            <div class="booking-auth-logo">ES</div>
            <div>
                <strong>EasySystems</strong>
                <span>Access control</span>
            </div>
        </div>

        <div class="booking-auth-icon is-error">!</div>

        <div class="booking-auth-header">
            <p class="booking-auth-eyebrow">Åtkomst nekad</p>
            <h1>Du har inte behörighet</h1>
            <p>Det här kontot har inte åtkomst till den här sidan eller funktionen.</p>
        </div>

        <div class="booking-auth-actions">
            <a class="booking-auth-primary-link" href="/">
                Till startsidan
            </a>

            <a class="booking-auth-secondary-link" href="/Account/Login">
                Byt konto
            </a>
        </div>
    </section>

    <section class="booking-auth-visual">
        <div>
            <span>EasySystems</span>
            <h2>Secure access.</h2>
            <p>Only authorized users can access protected booking tools.</p>
        </div>
    </section>
</div>