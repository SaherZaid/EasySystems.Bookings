@using EasySystems.Bookings.Data
@using EasySystems.Bookings.Data.Access
@using EasySystems.Bookings.Data.Entities
@using EasySystems.Bookings.Data.Identity

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.EntityFrameworkCore

@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject BusinessAccessService BusinessAccessService
@inject NavigationManager Navigation

<nav class="public-navbar" style="@GetNavbarStyle()">
    <div class="public-navbar-shell">

        <a class="public-navbar-brand" href="/" @onclick="CloseMenu">
            @if (!string.IsNullOrWhiteSpace(business?.LogoUrl))
            {
                <img class="public-navbar-brand-logo" src="@business.LogoUrl" alt="@business.Name" />
            }
            else
            {
                <span class="public-navbar-brand-logo public-navbar-logo">
                    @GetInitials()
                </span>
            }

            <span class="public-navbar-brand-text">
                <small>
                    @DisplayOrFallback(business?.BusinessType, "Bokning online")
                </small>

                <strong>
                    @DisplayOrFallback(business?.Name, "EasyBookings")
                </strong>
            </span>
        </a>

        <button type="button"
                class="public-navbar-toggle"
                @onclick="ToggleMenu"
                aria-label="Öppna meny">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="public-navbar-links @(isOpen ? "open" : "")">
            <NavLink href="/" Match="NavLinkMatch.All" @onclick="CloseMenu">
                Hem
            </NavLink>

            <NavLink href="/#hours" @onclick="CloseMenu">
                Öppettider
            </NavLink>

            <NavLink href="/#booking" @onclick="CloseMenu">
                Boka ny tid
            </NavLink>

            <NavLink href="/privacy" @onclick="CloseMenu">
                Integritet
            </NavLink>

            <NavLink href="/terms" @onclick="CloseMenu">
                Villkor
            </NavLink>

            @if (isAuthenticated)
            {
                <NavLink href="/Account/Profile" @onclick="CloseMenu">
                    Profil
                </NavLink>

                <NavLink href="/Account/Bookings" @onclick="CloseMenu">
                    Mina bokningar
                </NavLink>

                @if (canOpenAdmin)
                {
                    <NavLink href="@adminUrl" @onclick="CloseMenu">
                        Admin
                    </NavLink>
                }

                <form action="/Account/Logout"
                      method="post"
                      class="public-navbar-logout">

                    <AntiforgeryToken />

                    <input type="hidden"
                           name="returnUrl"
                           value="@GetLogoutReturnUrl()" />

                    <button type="submit">
                        Logga ut
                    </button>
                </form>
            }
            else
            {
                <NavLink href="/Account/Login" @onclick="CloseMenu">
                    Logga in
                </NavLink>

                <NavLink href="/Account/Register" @onclick="CloseMenu">
                    Skapa konto
                </NavLink>
            }
        </div>
    </div>
</nav>

@code {
    private Business? business;
    private bool isOpen;
    private bool isAuthenticated;
    private bool canOpenAdmin;
    private string adminUrl = "/admin/businesses";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        business = await db.Businesses
            .AsNoTracking()
            .Where(x => x.IsActive)
            .OrderByDescending(x => x.AllowOnlineBookings)
            .ThenByDescending(x => x.CreatedAt)
            .FirstOrDefaultAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        if (principal.Identity?.IsAuthenticated != true)
            return;

        isAuthenticated = true;

        if (principal.IsInRole(AppRoles.PlatformSuperAdmin))
        {
            canOpenAdmin = true;
            adminUrl = "/admin/businesses";
            return;
        }

        if (business is not null)
        {
            var permissions = await BusinessAccessService.GetPermissionsAsync(principal, business.Id);

            if (permissions.HasAccess)
            {
                canOpenAdmin = true;
                adminUrl = $"/admin/businesses/{business.Id}/overview";
            }
        }
    }

    private void ToggleMenu()
    {
        isOpen = !isOpen;
    }

    private void CloseMenu()
    {
        isOpen = false;
    }

    private string GetLogoutReturnUrl()
    {
        return "";
    }

    private string GetNavbarStyle()
    {
        if (business is null)
            return "";

        var logoSize = business.NavbarLogoSize <= 0 ? 42 : business.NavbarLogoSize;
        var navbarHeight = business.NavbarHeight <= 0 ? 64 : business.NavbarHeight;
        var radius = business.NavbarBorderRadius <= 0 ? 22 : business.NavbarBorderRadius;

        return string.Join(" ",
            $"--public-navbar-bg:{CssValue(business.NavbarBackgroundColor, "#FFFFFF")};",
            $"--public-navbar-text:{CssValue(business.NavbarTextColor, "#151515")};",
            $"--public-navbar-border:{CssValue(business.NavbarBorderColor, "#E5E7EB")};",
            $"--public-navbar-hover:{CssValue(business.NavbarLinkHoverColor, business.SecondaryColor)};",
            $"--public-navbar-mobile-bg:{CssValue(business.NavbarMobileBackgroundColor, business.NavbarBackgroundColor)};",
            $"--public-navbar-button-bg:{CssValue(business.NavbarButtonBackgroundColor, business.ButtonBackgroundColor)};",
            $"--public-navbar-button-text:{CssValue(business.NavbarButtonTextColor, business.ButtonTextColor)};",
            $"--public-navbar-brand-title:{CssValue(business.NavbarBrandTitleColor, "#2A1B17")};",
            $"--public-navbar-brand-subtitle:{CssValue(business.NavbarBrandSubtitleColor, "#6F4E45")};",
            $"--public-navbar-logo-bg:{CssValue(business.NavbarLogoBackgroundColor, "#151515")};",
            $"--public-navbar-logo-text:{CssValue(business.NavbarLogoTextColor, "#FFFFFF")};",
            $"--public-navbar-logo-size:{logoSize}px;",
            $"--public-navbar-height:{navbarHeight}px;",
            $"--public-navbar-radius:{radius}px;"
        );
    }

    private string GetInitials()
    {
        if (business is null || string.IsNullOrWhiteSpace(business.Name))
            return "EB";

        var parts = business.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return business.Name[0].ToString().ToUpper();
    }

    private static string DisplayOrFallback(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    private static string CssValue(string? value, string? fallback)
    {
        return string.IsNullOrWhiteSpace(value)
            ? fallback ?? ""
            : value;
    }
}