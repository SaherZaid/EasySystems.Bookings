@using EasySystems.Bookings.Data
@using EasySystems.Bookings.Data.Access
@using EasySystems.Bookings.Data.Entities
@using EasySystems.Bookings.Data.Identity

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore

@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject BusinessAccessService BusinessAccessService
@inject NavigationManager Navigation

<nav class="public-navbar @(business?.NavbarIsSticky == true ? "is-sticky" : "") @(business?.NavbarIsFloating == true ? "is-floating" : "")" style="@GetNavbarStyle()">
    <div class="public-navbar-shell">

        <a class="public-navbar-brand"
           href="/"
           data-enhance-nav="false"
           @onclick="CloseAllMenus">

            @if (!string.IsNullOrWhiteSpace(business?.LogoUrl))
            {
                <img class="public-navbar-brand-logo" src="@business.LogoUrl" alt="@business.Name" />
            }
            else
            {
                <span class="public-navbar-brand-logo public-navbar-logo">
                    @GetInitials()
                </span>
            }

            <span class="public-navbar-brand-text">
                <small>@DisplayOrFallback(business?.BusinessType, "Bokning online")</small>
                <strong>@DisplayOrFallback(business?.Name, "EasyBookings")</strong>
            </span>
        </a>

        <button type="button"
                class="public-navbar-toggle"
                @onclick="ToggleMenu"
                aria-label="Öppna meny">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="public-navbar-links @(isOpen ? "open" : "")">

            <a href="/"
               class="@GetActiveClass("/")"
               data-enhance-nav="false"
               @onclick="CloseAllMenus">
                Hem
            </a>

            <a href="/booking"
               class="@GetActiveClass("/booking")"
               data-enhance-nav="false"
               @onclick="CloseAllMenus">
                Boka ny tid
            </a>

            <a href="/services"
               class="@GetActiveClass("/services")"
               data-enhance-nav="false"
               @onclick="CloseAllMenus">
                Tjänster
            </a>

            <a href="/hours"
               class="@GetActiveClass("/hours")"
               data-enhance-nav="false"
               @onclick="CloseAllMenus">
                Öppettider/Kontakt
            </a>

            <div class="public-navbar-dropdown">
                <button type="button"
                        class="public-navbar-dropdown-button @(IsMoreActive ? "active" : "")"
                        @onclick="ToggleMoreMenu">
                    Mer
                    <span>▾</span>
                </button>

                <div class="public-navbar-dropdown-menu @(isMoreOpen ? "open" : "")">

                    @if (isAuthenticated)
                    {
                        <div class="public-navbar-dropdown-divider"></div>

                        <a href="/Account/Profile"
                           class="@GetActiveClass("/Account/Profile")"
                           data-enhance-nav="false"
                           @onclick="CloseAllMenus">
                            Profil
                        </a>

                        <a href="/Account/Bookings"
                           class="@GetActiveClass("/Account/Bookings")"
                           data-enhance-nav="false"
                           @onclick="CloseAllMenus">
                            Mina bokningar
                        </a>
                    }

                    <a href="/privacy"
                       class="@GetActiveClass("/privacy")"
                       data-enhance-nav="false"
                       @onclick="CloseAllMenus">
                        Integritet
                    </a>

                    

                    <a href="/terms"
                       class="@GetActiveClass("/terms")"
                       data-enhance-nav="false"
                       @onclick="CloseAllMenus">
                        Villkor
                    </a>

                    
                </div>
            </div>

            @if (isAuthenticated)
            {
                @if (canOpenAdmin)
                {
                    <a href="@adminUrl"
                       data-enhance-nav="false"
                       @onclick="CloseAllMenus">
                        Admin
                    </a>
                }

                <form action="/Account/Logout"
                      method="post"
                      class="public-navbar-logout">

                    <AntiforgeryToken />

                    <input type="hidden"
                           name="returnUrl"
                           value="@GetLogoutReturnUrl()" />

                    <button type="submit">
                        Logga ut
                    </button>
                </form>
            }
            else
            {
                <a href="/Account/Login"
                   class="@GetActiveClass("/Account/Login")"
                   data-enhance-nav="false"
                   @onclick="CloseAllMenus">
                    Logga in
                </a>

                <a href="/Account/Register"
                   class="@GetActiveClass("/Account/Register")"
                   data-enhance-nav="false"
                   @onclick="CloseAllMenus">
                    Skapa konto
                </a>
            }
        </div>
    </div>
</nav>

@code {
    private Business? business;
    private bool isOpen;
    private bool isMoreOpen;
    private bool isAuthenticated;
    private bool canOpenAdmin;
    private string adminUrl = "/admin/businesses";

    private bool IsMoreActive =>
    IsCurrentPath("/privacy")
    || IsCurrentPath("/terms")
    || IsCurrentPath("/Account/Profile")
    || IsCurrentPath("/Account/Bookings");

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        business = await db.Businesses
            .AsNoTracking()
            .Where(x => x.IsActive)
            .OrderByDescending(x => x.AllowOnlineBookings)
            .ThenByDescending(x => x.CreatedAt)
            .FirstOrDefaultAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        if (principal.Identity?.IsAuthenticated != true)
            return;

        isAuthenticated = true;

        if (principal.IsInRole(AppRoles.PlatformSuperAdmin))
        {
            canOpenAdmin = true;
            adminUrl = "/admin/businesses";
            return;
        }

        if (business is not null)
        {
            var permissions = await BusinessAccessService.GetPermissionsAsync(principal, business.Id);

            if (permissions.HasAccess)
            {
                canOpenAdmin = true;
                adminUrl = $"/admin/businesses/{business.Id}/overview";
            }
        }
    }

    private void ToggleMenu()
    {
        isOpen = !isOpen;

        if (!isOpen)
            isMoreOpen = false;
    }

    private void ToggleMoreMenu()
    {
        isMoreOpen = !isMoreOpen;
    }

    private void CloseAllMenus()
    {
        isOpen = false;
        isMoreOpen = false;
    }

    private string GetLogoutReturnUrl()
    {
        return "";
    }

    private string GetActiveClass(string path)
    {
        return IsCurrentPath(path) ? "active" : "";
    }

    private bool IsCurrentPath(string path)
    {
        var currentPath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');

        if (currentPath == "//")
            currentPath = "/";

        return string.Equals(currentPath, path, StringComparison.OrdinalIgnoreCase);
    }

    private string GetNavbarStyle()
    {
        if (business is null)
            return "";

        var logoSize = business.NavbarLogoSize <= 0 ? 42 : business.NavbarLogoSize;
        var navbarHeight = business.NavbarHeight <= 0 ? 64 : business.NavbarHeight;
        var radius = business.NavbarBorderRadius <= 0 ? 22 : business.NavbarBorderRadius;

        return string.Join(" ",
            $"--public-navbar-bg:{CssValue(business.NavbarBackgroundColor, "#FFFFFF")};",
            $"--public-navbar-text:{CssValue(business.NavbarTextColor, "#151515")};",
            $"--public-navbar-border:{CssValue(business.NavbarBorderColor, "#E5E7EB")};",

            $"--public-navbar-hover:{CssValue(business.NavbarLinkHoverColor, "#C9A46A")};",
            $"--public-navbar-active-bg:{CssValue(business.NavbarActiveBackgroundColor, "#F8F4ED")};",
            $"--public-navbar-active-text:{CssValue(business.NavbarActiveTextColor, "#151515")};",

            $"--public-navbar-button-bg:{CssValue(business.NavbarButtonBackgroundColor, "#151515")};",
            $"--public-navbar-button-text:{CssValue(business.NavbarButtonTextColor, "#FFFFFF")};",

            $"--public-navbar-mobile-bg:{CssValue(business.NavbarMobileBackgroundColor, business.NavbarBackgroundColor)};",

            $"--public-navbar-logo-bg:{CssValue(business.NavbarLogoBackgroundColor, "#151515")};",
            $"--public-navbar-logo-text:{CssValue(business.NavbarLogoTextColor, "#FFFFFF")};",

            $"--public-navbar-brand-title:{CssValue(business.NavbarBrandTitleColor, "#2A1B17")};",
            $"--public-navbar-brand-subtitle:{CssValue(business.NavbarBrandSubtitleColor, "#6F4E45")};",

            $"--public-navbar-shadow:{CssValue(business.NavbarShadowColor, "rgba(17,24,39,.10)")};",

            $"--public-navbar-logo-size:{logoSize}px;",
            $"--public-navbar-height:{navbarHeight}px;",
            $"--public-navbar-radius:{radius}px;"
        );
    }

    private string GetInitials()
    {
        if (business is null || string.IsNullOrWhiteSpace(business.Name))
            return "EB";

        var parts = business.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return business.Name[0].ToString().ToUpper();
    }

    private static string DisplayOrFallback(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    private static string CssValue(string? value, string? fallback)
    {
        return string.IsNullOrWhiteSpace(value)
            ? fallback ?? ""
            : value;
    }
}