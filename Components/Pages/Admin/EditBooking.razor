@page "/admin/businesses/{BusinessId:int}/bookings/edit/{Id:int}"
@rendermode InteractiveServer

@using EasySystems.Bookings.Components.Admin
@using EasySystems.Bookings.Data
@using EasySystems.Bookings.Data.Entities
@using Microsoft.EntityFrameworkCore
@using System.Globalization

@inherits AdminBusinessPageBase

@inject ApplicationDbContext Db

<PageTitle>Redigera bokning | EasySystems</PageTitle>

<AdminNavbar BusinessId="BusinessId" />

@if (!Permissions.HasAccess)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Kontrollerar åtkomst...</div>
        </div>
    </div>
}
else if (!Permissions.CanManageBookings)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-alert danger">
                Du har inte behörighet att hantera bokningar.
            </div>
        </div>
    </div>
}
else if (booking is null || business is null)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Laddar bokningen...</div>
        </div>
    </div>
}
else
{
    <div class="admin-page admin-edit-booking-page">
        <div class="admin-shell">

            <section class="admin-hero">
                <div>
                    <p class="admin-eyebrow">Redigera bokning</p>
                    <h1>@booking.CustomerName</h1>
                    <p>Ändra kund, tjänst, personal, tid, status och betalning.</p>
                </div>

                <div class="admin-hero-actions">
                    @if (Permissions.CanManageCalendar)
                    {
                        <a class="admin-secondary-btn" href="/admin/businesses/@BusinessId/calendar">
                            Kalender
                        </a>
                    }

                    <a class="admin-secondary-btn" href="/admin/businesses/@BusinessId/bookings">
                        Bokningar
                    </a>
                </div>
            </section>

            <div class="edit-booking-grid">

                <section class="edit-booking-card">
                    <EditForm Model="booking" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />

                        <div class="edit-booking-section">
                            <h2>Kundinformation</h2>

                            <div class="settings-two-cols">
                                <div>
                                    <label>Kundens namn</label>
                                    <InputText class="settings-input" @bind-Value="booking.CustomerName" />
                                </div>

                                <div>
                                    <label>Telefon</label>
                                    <InputText class="settings-input" @bind-Value="booking.CustomerPhone" />
                                </div>
                            </div>

                            <label>E-post</label>
                            <InputText class="settings-input" @bind-Value="booking.CustomerEmail" />
                        </div>

                        <div class="edit-booking-section">
                            <h2>Tjänst och personal</h2>

                            <label>Tjänst</label>
                            <InputSelect class="settings-input"
                                         @bind-Value="booking.ServiceId"
                                         @bind-Value:after="ReloadDayAsync">
                                @foreach (var service in services)
                                {
                                    <option value="@service.Id">
                                        @service.Name - @service.DurationMinutes min - @service.Price.ToString("0.00") kr
                                    </option>
                                }
                            </InputSelect>

                            <label>Personal</label>
                            <InputSelect class="settings-input"
                                         @bind-Value="booking.StaffMemberId"
                                         @bind-Value:after="ReloadDayAsync">
                                @foreach (var staff in staffMembers)
                                {
                                    <option value="@staff.Id">
                                        @staff.FullName
                                        @if (!string.IsNullOrWhiteSpace(staff.Specialization))
                                        {
                                            @($" - {staff.Specialization}")
                                        }
                                    </option>
                                }
                            </InputSelect>
                        </div>

                        <div class="edit-booking-section">
                            <h2>Datum och tid</h2>

                            <div class="create-booking-date-row">
                                <button type="button" class="booking-date-nav" @onclick="PreviousDay">
                                    Föregående
                                </button>

                                <InputDate class="settings-input"
                                           @bind-Value="bookingDate"
                                           @bind-Value:after="ReloadDayAsync" />

                                <button type="button" class="booking-date-nav" @onclick="NextDay">
                                    Nästa
                                </button>
                            </div>

                            <div class="booking-date-title">
                                <strong>@bookingDate.ToString("dddd d MMMM yyyy", SwedishCulture)</strong>
                                <span>@GetSelectedDayHoursLabel()</span>
                            </div>

                            @if (SelectedDayHours is null || !SelectedDayHours.IsOpen)
                            {
                                <div class="admin-alert warning">
                                    Verksamheten är stängd denna dag. Välj ett annat datum.
                                </div>
                            }
                            else if (!availableTimes.Any())
                            {
                                <div class="admin-alert warning">
                                    Det finns inga lediga tider för vald dag och personal.
                                </div>
                            }
                            else
                            {
                                <div class="admin-time-grid">
                                    @foreach (var time in availableTimes)
                                    {
                                        <button type="button"
                                                class="admin-time-chip @(bookingTime == time ? "active" : "")"
                                                @onclick="() => SelectTime(time)">
                                            @time.ToString(@"hh\:mm")
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="edit-booking-section">
                            <h2>Status</h2>

                            <label>Bokningsstatus</label>
                            <InputSelect class="settings-input" @bind-Value="booking.Status">
                                <option value="Pending">Väntar</option>
                                <option value="Confirmed">Bekräftad</option>
                                <option value="Cancelled">Avbokad</option>
                            </InputSelect>

                            @if (booking.Status == "Cancelled")
                            {
                                <label>Avbokningsorsak</label>
                                <InputTextArea class="settings-input settings-textarea"
                                               rows="3"
                                               @bind-Value="booking.CancellationReason" />
                            }
                        </div>

                        <div class="edit-booking-section">
                            <h2>Betalning</h2>

                            <label class="settings-switch">
                                <InputCheckbox @bind-Value="booking.IsPaid" />
                                <span>
                                    <strong>Betald</strong>
                                    <small>Markera om kunden redan har betalat.</small>
                                </span>
                            </label>

                            @if (booking.IsPaid)
                            {
                                <div class="settings-two-cols">
                                    <div>
                                        <label>Betalt belopp</label>
                                        <InputNumber class="settings-input" @bind-Value="booking.PaidAmount" />
                                    </div>

                                    <div>
                                        <label>Betalningsmetod</label>
                                        <InputText class="settings-input" @bind-Value="booking.PaymentMethod" />
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="edit-booking-section">
                            <h2>Anteckningar</h2>

                            <label>Intern anteckning</label>
                            <InputTextArea class="settings-input settings-textarea"
                                           rows="4"
                                           @bind-Value="booking.Notes" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="settings-alert error">@errorMessage</div>
                        }

                        @if (!string.IsNullOrWhiteSpace(successMessage))
                        {
                            <div class="settings-alert success">@successMessage</div>
                        }

                        <div class="settings-actions">
                            <button class="admin-primary-btn" type="submit" disabled="@isSaving">
                                @(isSaving ? "Sparar..." : "Spara ändringar")
                            </button>

                            <a class="admin-secondary-btn" href="/admin/businesses/@BusinessId/bookings">
                                Avbryt
                            </a>
                        </div>
                    </EditForm>
                </section>

                <aside class="edit-booking-side">
                    <section class="booking-summary-card">
                        <p class="admin-eyebrow">Bokning</p>

                        <h2>@GetSelectedServiceName()</h2>

                        <div class="booking-summary-list">
                            <div>
                                <span>Kund</span>
                                <strong>@DisplayOrFallback(booking.CustomerName, "Ej angiven")</strong>
                            </div>

                            <div>
                                <span>Datum</span>
                                <strong>@bookingDate.ToString("yyyy-MM-dd")</strong>
                            </div>

                            <div>
                                <span>Tid</span>
                                <strong>@GetSelectedTimeLabel()</strong>
                            </div>

                            <div>
                                <span>Personal</span>
                                <strong>@GetSelectedStaffName()</strong>
                            </div>

                            <div>
                                <span>Status</span>
                                <strong>@TranslateStatus(booking.Status)</strong>
                            </div>

                            <div>
                                <span>Betalning</span>
                                <strong>@(booking.IsPaid ? $"{booking.PaidAmount:0.00} kr" : "Ej betald")</strong>
                            </div>
                        </div>
                    </section>

                    <section class="booking-summary-card">
                        <div class="booking-panel-header">
                            <div>
                                <p class="admin-eyebrow">Samma dag</p>
                                <h2>@bookingDate.ToString("dddd", SwedishCulture)</h2>
                            </div>

                            <span>@dayBookings.Count bokningar</span>
                        </div>

                        @if (!dayBookings.Any())
                        {
                            <div class="booking-empty-day">
                                Inga andra bokningar denna dag.
                            </div>
                        }
                        else
                        {
                            <div class="booking-day-list">
                                @foreach (var item in dayBookings)
                                {
                                    <article class="booking-day-item @GetStatusClass(item.Status)">
                                        <div>
                                            <strong>@item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")</strong>
                                            <span>@item.CustomerName</span>
                                        </div>

                                        <div>
                                            <small>@item.Service.Name</small>
                                            <small>@item.StaffMember.FullName</small>
                                        </div>

                                        <a href="/admin/businesses/@BusinessId/bookings/edit/@item.Id">
                                            Ändra
                                        </a>
                                    </article>
                                }
                            </div>
                        }
                    </section>

                    <section class="booking-summary-card">
                        <p class="admin-eyebrow">Öppettider</p>

                        <div class="booking-hours-list">
                            @foreach (var day in weeklyHours)
                            {
                                <div class="booking-hours-row @(day.Day == bookingDate.DayOfWeek ? "active" : "")">
                                    <span>@day.Label</span>
                                    <strong>@(day.IsOpen ? $"{day.Open:hh\\:mm} - {day.Close:hh\\:mm}" : "Stängt")</strong>
                                </div>
                            }
                        </div>
                    </section>
                </aside>

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Booking? booking;
    private Business? business;

    private List<Service> services = [];
    private List<StaffMember> staffMembers = [];
    private List<Booking> dayBookings = [];
    private List<TimeSpan> availableTimes = [];
    private List<DayHoursModel> weeklyHours = [];

    private DateTime bookingDate;
    private TimeSpan bookingTime;

    private string? errorMessage;
    private string? successMessage;
    private bool isSaving;

    private static readonly CultureInfo SwedishCulture = new("sv-SE");

    private DayHoursModel? SelectedDayHours =>
        weeklyHours.FirstOrDefault(x => x.Day == bookingDate.DayOfWeek);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (!Permissions.HasAccess || !Permissions.CanManageBookings)
            return;

        business = await Db.Businesses
            .FirstOrDefaultAsync(b => b.Id == BusinessId);

        if (business is null)
        {
            Navigation.NavigateTo("/admin/businesses");
            return;
        }

        booking = await Db.Bookings
            .FirstOrDefaultAsync(b => b.Id == Id && b.BusinessId == BusinessId);

        if (booking is null)
        {
            Navigation.NavigateTo($"/admin/businesses/{BusinessId}/bookings");
            return;
        }

        services = await Db.Services
            .Where(s => s.BusinessId == BusinessId && (s.IsActive || s.Id == booking.ServiceId))
            .OrderBy(s => s.SortOrder)
            .ThenBy(s => s.Name)
            .ToListAsync();

        staffMembers = await Db.StaffMembers
            .Where(s => s.BusinessId == BusinessId && (s.IsActive || s.Id == booking.StaffMemberId))
            .OrderBy(s => s.SortOrder)
            .ThenBy(s => s.FullName)
            .ToListAsync();

        bookingDate = booking.StartTime.Date;
        bookingTime = booking.StartTime.TimeOfDay;

        LoadWeeklyHours();

        await ReloadDayAsync();
    }

    private async Task ReloadDayAsync()
    {
        errorMessage = null;

        await LoadDayBookingsAsync();
        BuildAvailableTimes();

        if (availableTimes.Any() && !availableTimes.Contains(bookingTime))
            bookingTime = availableTimes.First();
    }

    private async Task LoadDayBookingsAsync()
    {
        var start = bookingDate.Date;
        var end = start.AddDays(1);

        dayBookings = await Db.Bookings
            .AsNoTracking()
            .Include(b => b.Service)
            .Include(b => b.StaffMember)
            .Where(b =>
                b.BusinessId == BusinessId &&
                b.Id != Id &&
                b.StartTime >= start &&
                b.StartTime < end &&
                b.Status != "Cancelled")
            .OrderBy(b => b.StartTime)
            .ToListAsync();
    }

    private void BuildAvailableTimes()
    {
        availableTimes.Clear();

        if (business is null || booking is null)
            return;

        var dayHours = SelectedDayHours;

        if (dayHours is null || !dayHours.IsOpen)
            return;

        var service = services.FirstOrDefault(x => x.Id == booking.ServiceId);

        if (service is null || booking.StaffMemberId == 0)
            return;

        var current = dayHours.Open;
        var lastStart = dayHours.Close.Subtract(TimeSpan.FromMinutes(service.DurationMinutes));

        while (current <= lastStart)
        {
            var start = bookingDate.Date.Add(current);
            var end = start.AddMinutes(service.DurationMinutes);

            var hasConflict = dayBookings.Any(b =>
                b.StaffMemberId == booking.StaffMemberId &&
                start < b.EndTime &&
                end > b.StartTime);

            if (!hasConflict)
                availableTimes.Add(current);

            current = current.Add(TimeSpan.FromMinutes(business.BookingIntervalMinutes));
        }
    }

    private async Task PreviousDay()
    {
        bookingDate = bookingDate.AddDays(-1);
        await ReloadDayAsync();
    }

    private async Task NextDay()
    {
        bookingDate = bookingDate.AddDays(1);
        await ReloadDayAsync();
    }

    private void SelectTime(TimeSpan time)
    {
        bookingTime = time;
    }

    private async Task SaveAsync()
    {
        errorMessage = null;
        successMessage = null;

        if (booking is null || business is null)
            return;

        booking.CustomerName = booking.CustomerName.Trim();
        booking.CustomerEmail = booking.CustomerEmail?.Trim();
        booking.CustomerPhone = booking.CustomerPhone?.Trim();

        if (string.IsNullOrWhiteSpace(booking.CustomerName))
        {
            errorMessage = "Kundens namn krävs.";
            return;
        }

        var service = services.FirstOrDefault(s => s.Id == booking.ServiceId);

        if (service is null)
        {
            errorMessage = "Välj en tjänst.";
            return;
        }

        var staff = staffMembers.FirstOrDefault(s => s.Id == booking.StaffMemberId);

        if (staff is null)
        {
            errorMessage = "Välj personal.";
            return;
        }

        var dayHours = SelectedDayHours;

        if (dayHours is null || !dayHours.IsOpen)
        {
            errorMessage = "Verksamheten är stängd denna dag.";
            return;
        }

        booking.StartTime = bookingDate.Date.Add(bookingTime);
        booking.EndTime = booking.StartTime.AddMinutes(service.DurationMinutes);
        booking.UpdatedAt = DateTime.UtcNow;

        if (booking.StartTime.TimeOfDay < dayHours.Open ||
            booking.EndTime.TimeOfDay > dayHours.Close)
        {
            errorMessage = $"Bokningen måste vara inom öppettiderna: {dayHours.Open:hh\\:mm} - {dayHours.Close:hh\\:mm}.";
            return;
        }

        if (booking.IsPaid && booking.PaidAmount < 0)
        {
            errorMessage = "Betalt belopp kan inte vara negativt.";
            return;
        }

        if (!booking.IsPaid)
        {
            booking.PaidAmount = 0;
            booking.PaymentMethod = null;
        }

        if (booking.Status != "Cancelled")
        {
            booking.CancellationReason = null;
        }

        var hasConflict = await Db.Bookings
            .AnyAsync(b =>
                b.Id != booking.Id &&
                b.BusinessId == BusinessId &&
                b.StaffMemberId == booking.StaffMemberId &&
                b.Status != "Cancelled" &&
                booking.StartTime < b.EndTime &&
                booking.EndTime > b.StartTime);

        if (hasConflict)
        {
            errorMessage = "Personalen har redan en bokning under denna tid.";
            await ReloadDayAsync();
            return;
        }

        if (!availableTimes.Contains(bookingTime))
        {
            errorMessage = "Välj en ledig tid från listan.";
            await ReloadDayAsync();
            return;
        }

        isSaving = true;

        await Db.SaveChangesAsync();

        Navigation.NavigateTo($"/admin/businesses/{BusinessId}/bookings");
    }

    private void LoadWeeklyHours()
    {
        if (business is null)
            return;

        weeklyHours =
        [
            new("Måndag", DayOfWeek.Monday, business.MondayIsOpen, business.MondayOpeningTime, business.MondayClosingTime),
        new("Tisdag", DayOfWeek.Tuesday, business.TuesdayIsOpen, business.TuesdayOpeningTime, business.TuesdayClosingTime),
        new("Onsdag", DayOfWeek.Wednesday, business.WednesdayIsOpen, business.WednesdayOpeningTime, business.WednesdayClosingTime),
        new("Torsdag", DayOfWeek.Thursday, business.ThursdayIsOpen, business.ThursdayOpeningTime, business.ThursdayClosingTime),
        new("Fredag", DayOfWeek.Friday, business.FridayIsOpen, business.FridayOpeningTime, business.FridayClosingTime),
        new("Lördag", DayOfWeek.Saturday, business.SaturdayIsOpen, business.SaturdayOpeningTime, business.SaturdayClosingTime),
        new("Söndag", DayOfWeek.Sunday, business.SundayIsOpen, business.SundayOpeningTime, business.SundayClosingTime)
        ];
    }

    private string GetSelectedDayHoursLabel()
    {
        var day = SelectedDayHours;

        if (day is null || !day.IsOpen)
            return "Stängt";

        return $"{day.Open:hh\\:mm} - {day.Close:hh\\:mm}";
    }

    private string GetSelectedServiceName()
    {
        if (booking is null)
            return "Ingen tjänst vald";

        var service = services.FirstOrDefault(x => x.Id == booking.ServiceId);

        if (service is null)
            return "Ingen tjänst vald";

        return $"{service.Name} · {service.DurationMinutes} min · {service.Price:0.00} kr";
    }

    private string GetSelectedStaffName()
    {
        if (booking is null)
            return "Ingen personal vald";

        var staff = staffMembers.FirstOrDefault(x => x.Id == booking.StaffMemberId);

        return staff?.FullName ?? "Ingen personal vald";
    }

    private string GetSelectedTimeLabel()
    {
        if (bookingTime == default)
            return "Ingen tid vald";

        return bookingTime.ToString(@"hh\:mm");
    }

    private static string DisplayOrFallback(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    private static string TranslateStatus(string status)
    {
        return status switch
        {
            "Confirmed" => "Bekräftad",
            "Pending" => "Väntar",
            "Cancelled" => "Avbokad",
            _ => status
        };
    }

    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Confirmed" => "confirmed",
            "Pending" => "pending",
            "Cancelled" => "cancelled",
            _ => "other"
        };
    }

    private sealed class DayHoursModel
    {
        public DayHoursModel(string label, DayOfWeek day, bool isOpen, TimeSpan open, TimeSpan close)
        {
            Label = label;
            Day = day;
            IsOpen = isOpen;
            Open = open;
            Close = close;
        }

        public string Label { get; }
        public DayOfWeek Day { get; }
        public bool IsOpen { get; }
        public TimeSpan Open { get; }
        public TimeSpan Close { get; }
    }
}