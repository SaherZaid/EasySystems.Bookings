@page "/admin/businesses/{BusinessId:int}/overview"
@rendermode InteractiveServer

@using EasySystems.Bookings.Components.Admin
@using EasySystems.Bookings.Data
@using EasySystems.Bookings.Data.Entities
@using Microsoft.EntityFrameworkCore
@using System.Globalization

@inherits AdminBusinessPageBase

@inject ApplicationDbContext Db

<PageTitle>Översikt | EasySystems</PageTitle>

<AdminNavbar BusinessId="BusinessId" />

@if (!Permissions.HasAccess)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Kontrollerar åtkomst...</div>
        </div>
    </div>
}
else if (business is null)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Laddar översikt...</div>
        </div>
    </div>
}
else
{
    <div class="admin-page admin-overview-page">
        <div class="admin-shell">

            <section class="admin-hero overview-hero">
                <div>
                    <p class="admin-eyebrow">Översikt</p>
                    <h1>@business.Name</h1>
                    <p>@GetBusinessSubtitle()</p>
                </div>

                <div class="admin-hero-actions">
                    @if (Permissions.CanManageBookings)
                    {
                        <a class="admin-primary-btn" href="/admin/businesses/@BusinessId/bookings/create">
                            + Skapa bokning
                        </a>
                    }

                    @if (Permissions.CanManageCalendar)
                    {
                        <a class="admin-secondary-btn" href="/admin/businesses/@BusinessId/calendar">
                            Kalender
                        </a>
                    }
                </div>
            </section>

            <section class="overview-stats-grid">
                <div class="overview-stat-card">
                    <span>Dagens bokningar</span>
                    <strong>@todayBookingsCount</strong>
                    <small>@DateTime.Today.ToString("dddd d MMMM", SwedishCulture)</small>
                </div>

                <div class="overview-stat-card">
                    <span>Kommande bokningar</span>
                    <strong>@upcomingBookingsCount</strong>
                    <small>Från och med nu</small>
                </div>

                <div class="overview-stat-card">
                    <span>Aktiva tjänster</span>
                    <strong>@activeServicesCount</strong>
                    <small>Bokningsbara tjänster</small>
                </div>

                <div class="overview-stat-card">
                    <span>Aktiv personal</span>
                    <strong>@activeStaffCount</strong>
                    <small>Tillgänglig personal</small>
                </div>
            </section>

            <div class="overview-grid">
                <section class="overview-card today-card">
                    <div class="overview-card-header">
                        <div>
                            <p class="admin-eyebrow">Dagens schema</p>
                            <h2>Bokningar idag</h2>
                        </div>

                        @if (Permissions.CanManageCalendar)
                        {
                            <a href="/admin/businesses/@BusinessId/calendar">
                                Öppna kalender
                            </a>
                        }
                    </div>

                    @if (!todayBookings.Any())
                    {
                        <div class="overview-empty">
                            <h3>Inga bokningar idag</h3>
                            <p>Dagens schema är tomt.</p>
                        </div>
                    }
                    else
                    {
                        <div class="overview-booking-list">
                            @foreach (var booking in todayBookings)
                            {
                                <article class="overview-booking-item @GetStatusClass(booking.Status)">
                                    <div class="overview-booking-time">
                                        <strong>@booking.StartTime.ToString("HH:mm")</strong>
                                        <span>@booking.EndTime.ToString("HH:mm")</span>
                                    </div>

                                    <div class="overview-booking-info">
                                        <h3>@booking.CustomerName</h3>
                                        <p>@booking.Service.Name · @booking.StaffMember.FullName</p>

                                        @if (!string.IsNullOrWhiteSpace(booking.CustomerPhone))
                                        {
                                            <small>@booking.CustomerPhone</small>
                                        }
                                    </div>

                                    <div class="overview-booking-action">
                                        <span>@TranslateStatus(booking.Status)</span>

                                        @if (Permissions.CanManageBookings)
                                        {
                                            <a href="/admin/businesses/@BusinessId/bookings/edit/@booking.Id">
                                                Ändra
                                            </a>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>

                <aside class="overview-card quick-actions-card">
                    <div class="overview-card-header">
                        <div>
                            <p class="admin-eyebrow">Snabbval</p>
                            <h2>Hantera</h2>
                        </div>
                    </div>

                    <div class="overview-actions-grid">
                        @if (Permissions.CanManageBookings)
                        {
                            <a class="primary" href="/admin/businesses/@BusinessId/bookings/create">
                                Skapa bokning
                            </a>

                            <a href="/admin/businesses/@BusinessId/bookings">
                                Bokningar
                            </a>
                        }

                        @if (Permissions.CanManageServices)
                        {
                            <a href="/admin/businesses/@BusinessId/services">
                                Tjänster
                            </a>
                        }

                        @if (Permissions.CanManageStaff)
                        {
                            <a href="/admin/businesses/@BusinessId/staff">
                                Personal
                            </a>
                        }

                        @if (Permissions.CanManageCalendar)
                        {
                            <a href="/admin/businesses/@BusinessId/calendar">
                                Kalender
                            </a>
                        }

                        @if (Permissions.CanManageSettings)
                        {
                            <a href="/admin/businesses/edit/@BusinessId">
                                Inställningar
                            </a>
                        }

                        @if (Permissions.IsPlatformSuperAdmin || Permissions.Role == EasySystems.Bookings.Data.Identity.AppRoles.BusinessOwner || Permissions.CanManageSettings)
                        {
                            <a href="/admin/businesses/@BusinessId/roles">
                                Roller
                            </a>
                        }
                    </div>
                </aside>
            </div>

        </div>
    </div>
}

@code {
    private Business? business;

    private int todayBookingsCount;
    private int upcomingBookingsCount;
    private int activeServicesCount;
    private int activeStaffCount;

    private List<Booking> todayBookings = [];

    private static readonly CultureInfo SwedishCulture = new("sv-SE");

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (!Permissions.HasAccess)
            return;

        business = await Db.Businesses
            .FirstOrDefaultAsync(b => b.Id == BusinessId);

        if (business is null)
            return;

        var today = DateTime.Today;
        var tomorrow = today.AddDays(1);
        var now = DateTime.Now;

        todayBookingsCount = await Db.Bookings
            .CountAsync(b =>
                b.BusinessId == BusinessId &&
                b.StartTime >= today &&
                b.StartTime < tomorrow &&
                b.Status != "Cancelled");

        upcomingBookingsCount = await Db.Bookings
            .CountAsync(b =>
                b.BusinessId == BusinessId &&
                b.StartTime >= now &&
                b.Status != "Cancelled");

        activeServicesCount = await Db.Services
            .CountAsync(s => s.BusinessId == BusinessId && s.IsActive);

        activeStaffCount = await Db.StaffMembers
            .CountAsync(s => s.BusinessId == BusinessId && s.IsActive);

        todayBookings = await Db.Bookings
            .Include(b => b.Service)
            .Include(b => b.StaffMember)
            .Where(b =>
                b.BusinessId == BusinessId &&
                b.StartTime >= today &&
                b.StartTime < tomorrow)
            .OrderBy(b => b.StartTime)
            .ToListAsync();
    }

    private string GetBusinessSubtitle()
    {
        if (business is null)
            return "";

        var type = string.IsNullOrWhiteSpace(business.BusinessType)
            ? "Verksamhet"
            : business.BusinessType;

        var city = string.IsNullOrWhiteSpace(business.City)
            ? "Ingen stad angiven"
            : business.City;

        return $"{type} · {city}";
    }

    private static string TranslateStatus(string status)
    {
        return status switch
        {
            "Confirmed" => "Bekräftad",
            "Pending" => "Väntar",
            "Cancelled" => "Avbokad",
            _ => status
        };
    }

    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Confirmed" => "confirmed",
            "Pending" => "pending",
            "Cancelled" => "cancelled",
            _ => "other"
        };
    }
}