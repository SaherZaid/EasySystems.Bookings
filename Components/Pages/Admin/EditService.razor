@page "/admin/businesses/{BusinessId:int}/services/edit/{Id:int}"
@rendermode InteractiveServer

@using EasySystems.Bookings.Components.Admin
@using EasySystems.Bookings.Data
@using EasySystems.Bookings.Data.Entities
@using Microsoft.EntityFrameworkCore

@inherits AdminBusinessPageBase

@inject ApplicationDbContext Db

<PageTitle>Redigera tjänst | EasySystems</PageTitle>

<AdminNavbar BusinessId="BusinessId" />

@if (!Permissions.HasAccess)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Kontrollerar åtkomst...</div>
        </div>
    </div>
}
else if (!Permissions.CanManageServices)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-alert danger">
                Du har inte behörighet att hantera tjänster.
            </div>
        </div>
    </div>
}
else if (service is null || business is null)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Laddar tjänsten...</div>
        </div>
    </div>
}
else
{
    <div class="admin-page admin-service-form-page">
        <div class="admin-shell">

            <section class="admin-hero">
                <div>
                    <p class="admin-eyebrow">Redigera tjänst</p>
                    <h1>@service.Name</h1>
                    <p>Uppdatera namn, beskrivning, pris, tid och synlighet.</p>
                </div>

                <div class="admin-hero-actions">
                    <a class="admin-secondary-btn" href="/admin/businesses/@BusinessId/services">
                        Tillbaka
                    </a>
                </div>
            </section>

            <div class="service-form-grid">

                <section class="service-form-card">
                    <EditForm Model="service" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="settings-alert error" />

                        <div class="service-form-section">
                            <h2>Grundinformation</h2>

                            <label>Tjänstens namn</label>
                            <InputText class="settings-input" @bind-Value="service.Name" />
                            <ValidationMessage For="@(() => service.Name)" />

                            <label>Beskrivning</label>
                            <InputTextArea class="settings-input settings-textarea"
                                           rows="5"
                                           @bind-Value="service.Description" />
                            <ValidationMessage For="@(() => service.Description)" />
                        </div>

                        <div class="service-form-section">
                            <h2>Pris och tid</h2>

                            <div class="settings-three-cols">
                                <div>
                                    <label>Pris</label>
                                    <InputNumber class="settings-input" @bind-Value="service.Price" />
                                    <ValidationMessage For="@(() => service.Price)" />
                                </div>

                                <div>
                                    <label>Tid i minuter</label>
                                    <InputNumber class="settings-input" @bind-Value="service.DurationMinutes" />
                                    <ValidationMessage For="@(() => service.DurationMinutes)" />
                                </div>

                                <div>
                                    <label>Sortering</label>
                                    <InputNumber class="settings-input" @bind-Value="service.SortOrder" />
                                    <ValidationMessage For="@(() => service.SortOrder)" />
                                </div>
                            </div>
                        </div>

                        <div class="service-form-section">
                            <h2>Synlighet</h2>

                            <label class="settings-switch">
                                <InputCheckbox @bind-Value="service.IsActive" />
                                <span>
                                    <strong>Aktiv tjänst</strong>
                                    <small>Tjänsten visas för kunder och kan bokas.</small>
                                </span>
                            </label>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="settings-alert error">@errorMessage</div>
                        }

                        @if (!string.IsNullOrWhiteSpace(successMessage))
                        {
                            <div class="settings-alert success">@successMessage</div>
                        }

                        <div class="settings-actions">
                            <button class="admin-primary-btn" type="submit" disabled="@isSaving">
                                @(isSaving ? "Sparar..." : "Spara ändringar")
                            </button>

                            <a class="admin-secondary-btn" href="/admin/businesses/@BusinessId/services">
                                Avbryt
                            </a>
                        </div>
                    </EditForm>
                </section>

                <aside class="service-preview-card">
                    <p class="admin-eyebrow">Förhandsvisning</p>

                    <div class="service-preview-box">
                        <div>
                            <span class="service-preview-pill @(service.IsActive ? "active" : "inactive")">
                                @(service.IsActive ? "Aktiv" : "Inaktiv")
                            </span>

                            <h2>@DisplayOrFallback(service.Name, "Tjänstens namn")</h2>

                            <p>
                                @DisplayOrFallback(service.Description, "Här visas en kort beskrivning av tjänsten så kunden förstår vad som ingår.")
                            </p>
                        </div>

                        <div class="service-preview-meta">
                            <div>
                                <span>Pris</span>
                                <strong>@service.Price.ToString("0.00") kr</strong>
                            </div>

                            <div>
                                <span>Tid</span>
                                <strong>@service.DurationMinutes min</strong>
                            </div>

                            <div>
                                <span>Sortering</span>
                                <strong>@service.SortOrder</strong>
                            </div>
                        </div>
                    </div>

                    <div class="service-help-card">
                        <h3>Verksamhet</h3>
                        <p>@business.Name</p>

                        <h3>Senast uppdaterad</h3>
                        <p>@(service.UpdatedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "Inte uppdaterad ännu")</p>
                    </div>
                </aside>

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Service? service;
    private Business? business;
    private string? errorMessage;
    private string? successMessage;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (!Permissions.HasAccess || !Permissions.CanManageServices)
            return;

        business = await Db.Businesses
            .FirstOrDefaultAsync(b => b.Id == BusinessId);

        if (business is null)
        {
            Navigation.NavigateTo("/admin/businesses");
            return;
        }

        service = await Db.Services
            .FirstOrDefaultAsync(s => s.Id == Id && s.BusinessId == BusinessId);

        if (service is null)
        {
            Navigation.NavigateTo($"/admin/businesses/{BusinessId}/services");
        }
    }

    private async Task SaveAsync()
    {
        if (service is null)
            return;

        errorMessage = null;
        successMessage = null;
        isSaving = true;

        NormalizeService();

        if (!ValidateService())
        {
            isSaving = false;
            return;
        }

        service.UpdatedAt = DateTime.UtcNow;

        await Db.SaveChangesAsync();

        successMessage = "Tjänsten har sparats.";
        isSaving = false;
    }

    private void HandleInvalidSubmit()
    {
        isSaving = false;
        successMessage = null;
        errorMessage = "Kontrollera fälten. Något är fel eller saknas.";
    }

    private void NormalizeService()
    {
        if (service is null)
            return;

        service.Name = service.Name?.Trim() ?? string.Empty;
        service.Description = service.Description?.Trim();
    }

    private bool ValidateService()
    {
        if (service is null)
            return false;

        if (string.IsNullOrWhiteSpace(service.Name))
        {
            errorMessage = "Tjänstens namn krävs.";
            return false;
        }

        if (service.DurationMinutes <= 0)
        {
            errorMessage = "Tiden måste vara större än 0 minuter.";
            return false;
        }

        if (service.Price < 0)
        {
            errorMessage = "Priset kan inte vara negativt.";
            return false;
        }

        return true;
    }

    private static string DisplayOrFallback(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }
}