@page "/admin/businesses"
@rendermode InteractiveServer

@using EasySystems.Bookings.Data
@using EasySystems.Bookings.Data.Access
@using EasySystems.Bookings.Data.Entities
@using EasySystems.Bookings.Data.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims

@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject BusinessAccessService BusinessAccessService
@inject NavigationManager Navigation

@attribute [Authorize]

<PageTitle>Verksamheter | EasySystems</PageTitle>

<AdminNavbar BusinessId="navbarBusinessId" />

<div class="roles-page">
    <div class="roles-shell">

        <section class="businesses-top-hero">
            <div>
                <p class="roles-eyebrow">@heroLabel</p>
                <h1>@heroTitle</h1>
                <p>@heroDescription</p>
            </div>
        </section>

        @if (isLoading)
        {
            <div class="roles-loading">
                Laddar verksamhet...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="roles-empty">
                <h2>Åtkomst nekad</h2>
                <p>@errorMessage</p>
            </div>
        }
        else if (!businessCards.Any())
        {
            <div class="roles-empty">
                <h2>Ingen verksamhet hittades</h2>
                <p>Ditt konto är inte kopplat till någon aktiv verksamhet.</p>
            </div>
        }
        else
        {
            <section class="admin-business-grid">
                @foreach (var item in businessCards)
                {
                    var business = item.Business;
                    var permissions = item.Permissions;

                    <article class="admin-business-card">

                        <div class="admin-business-header">
                            <div class="roles-avatar">
                                @GetInitials(business.Name)
                            </div>

                            <div>
                                <h2>@business.Name</h2>
                                <p>@DisplayOrFallback(business.BusinessType, "Bokningsverksamhet")</p>
                            </div>
                        </div>

                        <div class="admin-business-actions-large">
                            @if (permissions.HasAccess)
                            {
                                <a class="primary" href="/admin/businesses/@business.Id/overview">
                                    Översikt
                                </a>
                            }

                            @if (permissions.CanManageServices)
                            {
                                <a href="/admin/businesses/@business.Id/services">
                                    Tjänster
                                </a>
                            }

                            @if (permissions.CanManageStaff)
                            {
                                <a href="/admin/businesses/@business.Id/staff">
                                    Personal
                                </a>
                            }

                            @if (permissions.CanManageBookings)
                            {
                                <a href="/admin/businesses/@business.Id/bookings">
                                    Bokningar
                                </a>
                            }

                            @if (permissions.CanManageCalendar)
                            {
                                <a href="/admin/businesses/@business.Id/calendar">
                                    Kalender
                                </a>
                            }

                            @if (permissions.IsPlatformSuperAdmin || permissions.Role == AppRoles.BusinessOwner || permissions.CanManageSettings)
                            {
                                <a href="/admin/businesses/@business.Id/roles">
                                    Hantera Roller
                                </a>
                            }

                            @if (permissions.CanManageSettings)
                            {
                                <a href="/admin/businesses/edit/@business.Id">
                                    Inställningar
                                </a>

                                <a href="/admin/businesses/@business.Id/legal">
                                    Juridik
                                </a>
                            }
                        </div>

                        <div class="admin-business-meta">
                            <div>
                                <span>Plats</span>
                                <strong>@GetLocation(business)</strong>
                            </div>

                            <div>
                                <span>Idag</span>
                                <strong>@GetTodayHoursText(business)</strong>
                            </div>

                            <div>
                                <span>Bokningsintervall</span>
                                <strong>@business.BookingIntervalMinutes min</strong>
                            </div>
                        </div>

                        <div class="business-week-card">
                            <div class="business-week-header">
                                <strong>Öppettider</strong>
                                <span>@GetWeeklyOpenDaysCount(business) öppna dagar</span>
                            </div>

                            <div class="business-week-list">
                                @foreach (var day in GetWeeklyHours(business))
                                {
                                    <div class="business-week-row @(day.IsOpen ? "open" : "closed")">
                                        <span>@day.Label</span>
                                        <strong>@(day.IsOpen ? $"{day.Open:hh\\:mm} - {day.Close:hh\\:mm}" : "Stängt")</strong>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="admin-business-status">
                            @if (business.IsActive)
                            {
                                <span class="roles-status-pill active">Aktiv</span>
                            }
                            else
                            {
                                <span class="roles-status-pill muted">Inaktiv</span>
                            }

                            @if (business.AllowOnlineBookings)
                            {
                                <span class="roles-status-pill">Onlinebokning</span>
                            }
                            else
                            {
                                <span class="roles-status-pill muted">Onlinebokning av</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(permissions.Role))
                            {
                                <span class="roles-status-pill muted">@permissions.Role</span>
                            }
                        </div>

                    </article>
                }
            </section>
        }

    </div>
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private int? navbarBusinessId;

    private string heroLabel = "Admin";
    private string heroTitle = "Verksamhet";
    private string heroDescription = "Öppna de verktyg du har behörighet att använda.";

    private List<BusinessCardModel> businessCards = [];

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        if (principal.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/Account/Login", forceLoad: true);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        if (principal.IsInRole(AppRoles.PlatformSuperAdmin))
        {
            heroLabel = "Platform admin";
            heroTitle = "Verksamheter";
            heroDescription = "Välj en verksamhet och hantera dess bokningssystem.";

            var businesses = await db.Businesses
                .AsNoTracking()
                .OrderByDescending(b => b.CreatedAt)
                .ToListAsync();

            businessCards = businesses
                .Select(b => new BusinessCardModel
                    {
                        Business = b,
                        Permissions = new BusinessPermissionResult
                        {
                            HasAccess = true,
                            IsPlatformSuperAdmin = true,
                            Role = AppRoles.PlatformSuperAdmin,
                            CanManageServices = true,
                            CanManageStaff = true,
                            CanManageBookings = true,
                            CanManageCalendar = true,
                            CanManageSettings = true
                        }
                    })
                .ToList();

            isLoading = false;
            return;
        }

        var userId = principal.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrWhiteSpace(userId))
        {
            errorMessage = "Vi kunde inte identifiera ditt konto.";
            isLoading = false;
            return;
        }

        var business = await db.BusinessUsers
            .AsNoTracking()
            .Where(x => x.UserId == userId)
            .Where(x => x.Business.IsActive)
            .Select(x => x.Business)
            .FirstOrDefaultAsync();

        if (business is null)
        {
            errorMessage = "Ditt konto är inte kopplat till någon aktiv verksamhet.";
            isLoading = false;
            return;
        }

        var permissions = await BusinessAccessService.GetPermissionsAsync(principal, business.Id);

        if (!permissions.HasAccess)
        {
            errorMessage = "Du har inte behörighet att öppna denna verksamhet.";
            isLoading = false;
            return;
        }

        navbarBusinessId = business.Id;

        heroLabel = "Verksamhetsadmin";
        heroTitle = business.Name;
        heroDescription = "Använd navigationen eller knapparna nedan för att öppna dina verktyg.";

        businessCards =
        [
            new BusinessCardModel
            {
                Business = business,
                Permissions = permissions
            }
        ];

        isLoading = false;
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "EB";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return name[0].ToString().ToUpper();
    }

    private static string GetLocation(Business business)
    {
        if (!string.IsNullOrWhiteSpace(business.City))
            return business.City;

        if (!string.IsNullOrWhiteSpace(business.Address))
            return business.Address;

        return "Ingen plats";
    }

    private static string DisplayOrFallback(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    private static string GetTodayHoursText(Business business)
    {
        var today = GetDayHours(business, DateTime.Today.DayOfWeek);

        if (!today.IsOpen)
            return "Stängt idag";

        return $"{today.Open:hh\\:mm} - {today.Close:hh\\:mm}";
    }

    private static int GetWeeklyOpenDaysCount(Business business)
    {
        return GetWeeklyHours(business).Count(x => x.IsOpen);
    }

    private static List<DayHoursModel> GetWeeklyHours(Business business)
    {
        return
        [
            new("Mån", business.MondayIsOpen, business.MondayOpeningTime, business.MondayClosingTime),
        new("Tis", business.TuesdayIsOpen, business.TuesdayOpeningTime, business.TuesdayClosingTime),
        new("Ons", business.WednesdayIsOpen, business.WednesdayOpeningTime, business.WednesdayClosingTime),
        new("Tor", business.ThursdayIsOpen, business.ThursdayOpeningTime, business.ThursdayClosingTime),
        new("Fre", business.FridayIsOpen, business.FridayOpeningTime, business.FridayClosingTime),
        new("Lör", business.SaturdayIsOpen, business.SaturdayOpeningTime, business.SaturdayClosingTime),
        new("Sön", business.SundayIsOpen, business.SundayOpeningTime, business.SundayClosingTime)
        ];
    }

    private static DayHoursModel GetDayHours(Business business, DayOfWeek day)
    {
        return day switch
        {
            DayOfWeek.Monday => new("Mån", business.MondayIsOpen, business.MondayOpeningTime, business.MondayClosingTime),
            DayOfWeek.Tuesday => new("Tis", business.TuesdayIsOpen, business.TuesdayOpeningTime, business.TuesdayClosingTime),
            DayOfWeek.Wednesday => new("Ons", business.WednesdayIsOpen, business.WednesdayOpeningTime, business.WednesdayClosingTime),
            DayOfWeek.Thursday => new("Tor", business.ThursdayIsOpen, business.ThursdayOpeningTime, business.ThursdayClosingTime),
            DayOfWeek.Friday => new("Fre", business.FridayIsOpen, business.FridayOpeningTime, business.FridayClosingTime),
            DayOfWeek.Saturday => new("Lör", business.SaturdayIsOpen, business.SaturdayOpeningTime, business.SaturdayClosingTime),
            DayOfWeek.Sunday => new("Sön", business.SundayIsOpen, business.SundayOpeningTime, business.SundayClosingTime),
            _ => new("", false, TimeSpan.Zero, TimeSpan.Zero)
        };
    }

    private sealed class BusinessCardModel
    {
        public Business Business { get; set; } = default!;
        public BusinessPermissionResult Permissions { get; set; } = new();
    }

    private sealed record DayHoursModel(
        string Label,
        bool IsOpen,
        TimeSpan Open,
        TimeSpan Close);
}