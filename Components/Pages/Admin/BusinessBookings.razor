@page "/admin/businesses/{BusinessId:int}/bookings"
@rendermode InteractiveServer

@using EasySystems.Bookings.Components.Admin
@using EasySystems.Bookings.Data
@using EasySystems.Bookings.Data.Entities
@using Microsoft.EntityFrameworkCore

@inherits AdminBusinessPageBase

@inject ApplicationDbContext Db

<PageTitle>Bokningar | EasySystems</PageTitle>

<AdminNavbar BusinessId="BusinessId" />

@if (!Permissions.HasAccess)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Kontrollerar åtkomst...</div>
        </div>
    </div>
}
else if (!Permissions.CanManageBookings)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-alert danger">
                Du har inte behörighet att hantera bokningar.
            </div>
        </div>
    </div>
}
else if (business is null)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Laddar bokningar...</div>
        </div>
    </div>
}
else
{
    <div class="admin-page bookings-admin-page">
        <div class="admin-shell">

            <section class="admin-hero">
                <div>
                    <p class="admin-eyebrow">Bokningar & försäljning</p>
                    <h1>@business.Name</h1>
                    <p>@GetBusinessSubtitle()</p>
                </div>

                <div class="admin-hero-actions">
                    <a class="admin-primary-btn" href="/admin/businesses/@BusinessId/bookings/create">
                        + Skapa bokning
                    </a>

                    @if (Permissions.CanManageCalendar)
                    {
                        <a class="admin-secondary-btn" href="/admin/businesses/@BusinessId/calendar">
                            Kalender
                        </a>
                    }

                    <a class="admin-secondary-btn" href="/admin/businesses/@BusinessId/overview">
                        Översikt
                    </a>
                </div>
            </section>

            <section class="booking-toolbar advanced">
                <div class="booking-search wide">
                    <label>Sök</label>
                    <input @bind="searchText"
                           @bind:event="oninput"
                           placeholder="Kund, e-post, telefon, tjänst, personal eller anteckning..." />
                </div>

                <div class="booking-filter">
                    <label>Period</label>
                    <select @bind="periodFilter">
                        <option value="all">Alla perioder</option>
                        <option value="today">Idag</option>
                        <option value="week">Denna vecka</option>
                        <option value="month">Denna månad</option>
                        <option value="next30">Nästa 30 dagar</option>
                        <option value="past">Tidigare</option>
                    </select>
                </div>

                <div class="booking-filter">
                    <label>Status</label>
                    <select @bind="statusFilter">
                        <option value="">Alla statusar</option>
                        <option value="Pending">Väntar</option>
                        <option value="Confirmed">Bekräftad</option>
                        <option value="Cancelled">Avbokad</option>
                    </select>
                </div>

                <div class="booking-filter">
                    <label>Betalning</label>
                    <select @bind="paymentFilter">
                        <option value="">Alla betalningar</option>
                        <option value="paid">Betald</option>
                        <option value="unpaid">Obetald</option>
                    </select>
                </div>

                <div class="booking-filter">
                    <label>Tjänst</label>
                    <select @bind="serviceFilter">
                        <option value="">Alla tjänster</option>
                        @foreach (var service in ServicesForFilter)
                        {
                            <option value="@service">@service</option>
                        }
                    </select>
                </div>

                <div class="booking-filter">
                    <label>Personal</label>
                    <select @bind="staffFilter">
                        <option value="">All personal</option>
                        @foreach (var staff in StaffForFilter)
                        {
                            <option value="@staff">@staff</option>
                        }
                    </select>
                </div>

                <div class="booking-filter action-filter">
                    <label>&nbsp;</label>
                    <button type="button" class="admin-secondary-btn" @onclick="ResetFilters">
                        Rensa filter
                    </button>
                </div>
            </section>

            <section class="booking-stat-grid">
                <div class="booking-stat-card">
                    <span>Resultat</span>
                    <strong>@FilteredCount</strong>
                    <p>bokningar i aktuell filtrering</p>
                </div>

                <div class="booking-stat-card">
                    <span>Betalt</span>
                    <strong>@FilteredPaidAmount.ToString("0.00") kr</strong>
                    <p>@FilteredPaidCount bokningar · @FilteredPaymentRate.ToString("0")%</p>
                </div>

                <div class="booking-stat-card">
                    <span>Obetalt</span>
                    <strong>@FilteredUnpaidPotential.ToString("0.00") kr</strong>
                    <p>@FilteredUnpaidCount bokningar</p>
                </div>

                <div class="booking-stat-card">
                    <span>Väntar</span>
                    <strong>@FilteredPendingCount</strong>
                    <p>behöver hanteras</p>
                </div>

                <div class="booking-stat-card">
                    <span>Kommande</span>
                    <strong>@FilteredUpcomingCount</strong>
                    <p>framtida bokningar</p>
                </div>

                <div class="booking-stat-card">
                    <span>Avbokade</span>
                    <strong>@FilteredCancelledCount</strong>
                    <p>förlorade bokningar</p>
                </div>

                <div class="booking-stat-card">
                    <span>Snittvärde</span>
                    <strong>@FilteredAverageValue.ToString("0.00") kr</strong>
                    <p>per betald bokning</p>
                </div>

                <div class="booking-stat-card">
                    <span>Total potential</span>
                    <strong>@FilteredTotalPotential.ToString("0.00") kr</strong>
                    <p>betalt + obetalt</p>
                </div>
            </section>

            <section class="booking-sales-grid">
                <div class="booking-sales-card">
                    <div class="booking-section-title">
                        <div>
                            <span>Försäljning</span>
                            <h2>Översikt baserat på filter</h2>
                        </div>
                    </div>

                    <div class="booking-kpi-list">
                        <div>
                            <span>Betalt</span>
                            <strong>@FilteredPaidAmount.ToString("0.00") kr</strong>
                        </div>
                        <div>
                            <span>Obetalt värde</span>
                            <strong>@FilteredUnpaidPotential.ToString("0.00") kr</strong>
                        </div>
                        <div>
                            <span>Total potential</span>
                            <strong>@FilteredTotalPotential.ToString("0.00") kr</strong>
                        </div>
                        <div>
                            <span>Betalningsgrad</span>
                            <strong>@FilteredPaymentRate.ToString("0")%</strong>
                        </div>
                    </div>
                </div>

                <div class="booking-sales-card">
                    <div class="booking-section-title">
                        <div>
                            <span>Populärast</span>
                            <h2>Tjänster</h2>
                        </div>
                    </div>

                    @if (!TopServices.Any())
                    {
                        <p class="booking-muted-text">Ingen statistik ännu.</p>
                    }
                    else
                    {
                        <div class="booking-ranking-list">
                            @foreach (var item in TopServices)
                            {
                                <div>
                                    <span>@item.Name</span>
                                    <strong>@item.Count bokningar · @item.Revenue.ToString("0.00") kr</strong>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="booking-sales-card">
                    <div class="booking-section-title">
                        <div>
                            <span>Prestation</span>
                            <h2>Personal</h2>
                        </div>
                    </div>

                    @if (!TopStaff.Any())
                    {
                        <p class="booking-muted-text">Ingen statistik ännu.</p>
                    }
                    else
                    {
                        <div class="booking-ranking-list">
                            @foreach (var item in TopStaff)
                            {
                                <div>
                                    <span>@item.Name</span>
                                    <strong>@item.Count bokningar · @item.Revenue.ToString("0.00") kr</strong>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>

            @if (!FilteredBookingList.Any())
            {
                <div class="admin-empty-card">
                    <h2>Inga bokningar hittades</h2>
                    <p>Prova att ändra filtren eller skapa en ny bokning.</p>

                    <a class="admin-primary-btn" href="/admin/businesses/@BusinessId/bookings/create">
                        Skapa bokning
                    </a>
                </div>
            }
            else
            {
                <section class="booking-card-list">
                    @foreach (var booking in FilteredBookingList)
                    {
                        <article class="booking-card">
                            <div class="booking-card-main">
                                <div class="booking-date-box">
                                    <strong>@booking.StartTime.ToString("dd")</strong>
                                    <span>@booking.StartTime.ToString("MMM", SwedishCulture)</span>
                                </div>

                                <div class="booking-main-info">
                                    <div class="booking-card-title-row">
                                        <div>
                                            <h2>@DisplayOrFallback(booking.CustomerName, "Ingen kund")</h2>
                                            <p>
                                                @booking.StartTime.ToString("yyyy-MM-dd")
                                                ·
                                                @booking.StartTime.ToString("HH:mm")
                                                -
                                                @booking.EndTime.ToString("HH:mm")
                                            </p>
                                        </div>

                                        <div class="booking-badges">
                                            <span class="@GetStatusClass(booking.Status)">
                                                @TranslateStatus(booking.Status)
                                            </span>

                                            <span class="@GetPaymentClass(booking.IsPaid)">
                                                @(booking.IsPaid ? "Betald" : "Obetald")
                                            </span>
                                        </div>
                                    </div>

                                    <div class="booking-detail-grid">
                                        <div>
                                            <span>Kundinformation</span>
                                            <strong>@DisplayOrFallback(booking.CustomerName, "Ingen kund")</strong>
                                            <small>@DisplayOrFallback(booking.CustomerEmail, "Ingen e-post")</small>
                                            <small>@DisplayOrFallback(booking.CustomerPhone, "Inget telefonnummer")</small>
                                        </div>

                                        <div>
                                            <span>Tjänst</span>
                                            <strong>@booking.Service.Name</strong>
                                            <small>
                                                @booking.Service.DurationMinutes min · @booking.Service.Price.ToString("0.00") kr
                                            </small>
                                        </div>

                                        <div>
                                            <span>Personal</span>
                                            <strong>@booking.StaffMember.FullName</strong>
                                            <small>
                                                @(string.IsNullOrWhiteSpace(booking.StaffMember.Specialization)
                                                    ? "Ingen specialisering"
                                                    : booking.StaffMember.Specialization)
                                            </small>
                                        </div>

                                        <div>
                                            <span>Betalning</span>
                                            <strong>
                                                @(booking.IsPaid
                                                    ? $"{booking.PaidAmount:0.00} kr"
                                                    : $"{booking.Service.Price:0.00} kr obetalt")
                                            </strong>
                                            <small>
                                                @(string.IsNullOrWhiteSpace(booking.PaymentMethod)
                                                    ? "Ingen betalningsmetod"
                                                    : booking.PaymentMethod)
                                            </small>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(booking.Notes))
                                    {
                                        <div class="booking-note">
                                            @booking.Notes
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="booking-card-actions">
                                <a href="/admin/businesses/@BusinessId/bookings/edit/@booking.Id">
                                    Redigera bokning
                                </a>
                            </div>
                        </article>
                    }
                </section>
            }
        </div>
    </div>
}

@code {
    private Business? business;
    private List<Booking> bookings = [];

    private string searchText = "";
    private string statusFilter = "";
    private string paymentFilter = "";
    private string periodFilter = "month";
    private string serviceFilter = "";
    private string staffFilter = "";

    private static readonly System.Globalization.CultureInfo SwedishCulture = new("sv-SE");

    private List<string> ServicesForFilter =>
        bookings
            .Where(b => b.Service is not null)
            .Select(b => b.Service.Name)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList();

    private List<string> StaffForFilter =>
        bookings
            .Where(b => b.StaffMember is not null)
            .Select(b => b.StaffMember.FullName)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList();

    private IEnumerable<Booking> FilteredBookings =>
        bookings
            .Where(MatchesSearch)
            .Where(MatchesStatus)
            .Where(MatchesPayment)
            .Where(MatchesPeriod)
            .Where(MatchesService)
            .Where(MatchesStaff)
            .OrderByDescending(b => b.StartTime);

    private List<Booking> FilteredBookingList =>
        FilteredBookings.ToList();

    private int FilteredCount =>
        FilteredBookingList.Count;

    private int FilteredPaidCount =>
        FilteredBookingList.Count(b => b.IsPaid);

    private int FilteredUnpaidCount =>
        FilteredBookingList.Count(b => !b.IsPaid && !IsCancelled(b));

    private int FilteredPendingCount =>
        FilteredBookingList.Count(b => string.Equals(b.Status, "Pending", StringComparison.OrdinalIgnoreCase));

    private int FilteredUpcomingCount =>
        FilteredBookingList.Count(b => b.StartTime >= DateTime.Now && !IsCancelled(b));

    private int FilteredCancelledCount =>
        FilteredBookingList.Count(IsCancelled);

    private decimal FilteredPaidAmount =>
        FilteredBookingList
            .Where(b => b.IsPaid && !IsCancelled(b))
            .Sum(b => b.PaidAmount);

    private decimal FilteredUnpaidPotential =>
        FilteredBookingList
            .Where(b => !b.IsPaid && !IsCancelled(b))
            .Sum(b => b.Service.Price);

    private decimal FilteredTotalPotential =>
        FilteredPaidAmount + FilteredUnpaidPotential;

    private decimal FilteredAverageValue =>
        FilteredPaidCount == 0 ? 0 : FilteredPaidAmount / FilteredPaidCount;

    private decimal FilteredPaymentRate =>
        FilteredCount == 0 ? 0 : ((decimal)FilteredPaidCount / FilteredCount) * 100;

    private IEnumerable<SalesRankingItem> TopServices =>
        FilteredBookingList
            .Where(b => !IsCancelled(b))
            .GroupBy(b => b.Service.Name)
            .Select(g => new SalesRankingItem(
                g.Key,
                g.Count(),
                g.Sum(b => b.IsPaid ? b.PaidAmount : 0)))
            .OrderByDescending(x => x.Revenue)
            .ThenByDescending(x => x.Count)
            .Take(5);

    private IEnumerable<SalesRankingItem> TopStaff =>
        FilteredBookingList
            .Where(b => !IsCancelled(b))
            .GroupBy(b => b.StaffMember.FullName)
            .Select(g => new SalesRankingItem(
                g.Key,
                g.Count(),
                g.Sum(b => b.IsPaid ? b.PaidAmount : 0)))
            .OrderByDescending(x => x.Revenue)
            .ThenByDescending(x => x.Count)
            .Take(5);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (!Permissions.HasAccess || !Permissions.CanManageBookings)
            return;

        business = await Db.Businesses
            .FirstOrDefaultAsync(b => b.Id == BusinessId);

        if (business is null)
            return;

        bookings = await Db.Bookings
            .Include(b => b.Service)
            .Include(b => b.StaffMember)
            .Where(b => b.BusinessId == BusinessId)
            .OrderByDescending(b => b.StartTime)
            .ToListAsync();
    }

    private bool MatchesSearch(Booking booking)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return true;

        var term = searchText.Trim();

        return (booking.CustomerName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (booking.CustomerEmail?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (booking.CustomerPhone?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (booking.Service?.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (booking.StaffMember?.FullName.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (booking.Notes?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private bool MatchesStatus(Booking booking)
    {
        if (string.IsNullOrWhiteSpace(statusFilter))
            return true;

        return string.Equals(booking.Status, statusFilter, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesPayment(Booking booking)
    {
        return paymentFilter switch
        {
            "paid" => booking.IsPaid,
            "unpaid" => !booking.IsPaid,
            _ => true
        };
    }

    private bool MatchesPeriod(Booking booking)
    {
        var today = DateTime.Today;
        var now = DateTime.Now;
        var startOfWeek = StartOfWeek(today);
        var startOfMonth = new DateTime(today.Year, today.Month, 1);

        return periodFilter switch
        {
            "today" => booking.StartTime.Date == today,
            "week" => booking.StartTime.Date >= startOfWeek,
            "month" => booking.StartTime.Date >= startOfMonth,
            "next30" => booking.StartTime >= now && booking.StartTime <= now.AddDays(30),
            "past" => booking.StartTime < now,
            _ => true
        };
    }

    private bool MatchesService(Booking booking)
    {
        if (string.IsNullOrWhiteSpace(serviceFilter))
            return true;

        return string.Equals(booking.Service?.Name, serviceFilter, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesStaff(Booking booking)
    {
        if (string.IsNullOrWhiteSpace(staffFilter))
            return true;

        return string.Equals(booking.StaffMember?.FullName, staffFilter, StringComparison.OrdinalIgnoreCase);
    }

    private void ResetFilters()
    {
        searchText = "";
        statusFilter = "";
        paymentFilter = "";
        periodFilter = "month";
        serviceFilter = "";
        staffFilter = "";
    }

    private string GetBusinessSubtitle()
    {
        var type = string.IsNullOrWhiteSpace(business?.BusinessType)
            ? "Bokningsverksamhet"
            : business.BusinessType;

        return $"{type} · Öppet {business!.OpeningTime:hh\\:mm} till {business.ClosingTime:hh\\:mm}";
    }

    private static DateTime StartOfWeek(DateTime date)
    {
        var diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        return date.AddDays(-diff).Date;
    }

    private static bool IsCancelled(Booking booking)
    {
        return string.Equals(booking.Status, "Cancelled", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Confirmed" => "booking-pill success",
            "Pending" => "booking-pill warning",
            "Cancelled" => "booking-pill danger",
            _ => "booking-pill muted"
        };
    }

    private static string TranslateStatus(string status)
    {
        return status switch
        {
            "Confirmed" => "Bekräftad",
            "Pending" => "Väntar",
            "Cancelled" => "Avbokad",
            _ => status
        };
    }

    private static string GetPaymentClass(bool isPaid)
    {
        return isPaid
            ? "booking-pill success"
            : "booking-pill neutral";
    }

    private static string DisplayOrFallback(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value)
            ? fallback
            : value;
    }

    private sealed record SalesRankingItem(string Name, int Count, decimal Revenue);
}