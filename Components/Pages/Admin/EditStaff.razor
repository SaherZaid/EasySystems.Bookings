@page "/admin/businesses/{BusinessId:int}/staff/edit/{Id:int}"
@rendermode InteractiveServer

@using EasySystems.Bookings.Components.Admin
@using EasySystems.Bookings.Data
@using EasySystems.Bookings.Data.Entities
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using System.IO

@inherits AdminBusinessPageBase

@inject ApplicationDbContext Db
@inject IWebHostEnvironment Environment

<PageTitle>Redigera personal | EasySystems</PageTitle>

<AdminNavbar BusinessId="BusinessId" />

@if (!Permissions.HasAccess)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Kontrollerar åtkomst...</div>
        </div>
    </div>
}
else if (!Permissions.CanManageStaff)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-alert danger">
                Du har inte behörighet att hantera personal.
            </div>
        </div>
    </div>
}
else if (staffMember is null || business is null)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Laddar personal...</div>
        </div>
    </div>
}
else
{
    <div class="admin-page admin-staff-form-page">
        <div class="admin-shell">

            <section class="admin-hero">
                <div>
                    <p class="admin-eyebrow">Redigera personal</p>
                    <h1>@staffMember.FullName</h1>
                    <p>Uppdatera profil, kontaktuppgifter, synlighet och onlinebokning.</p>
                </div>

                <div class="admin-hero-actions">
                    <a class="admin-secondary-btn" href="/admin/businesses/@BusinessId/staff">
                        Tillbaka
                    </a>
                </div>
            </section>

            <div class="staff-form-grid">

                <section class="staff-form-card">
                    <EditForm Model="staffMember" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />

                        <div class="staff-form-section">
                            <h2>Grundinformation</h2>

                            <label>Fullständigt namn</label>
                            <InputText class="settings-input" @bind-Value="staffMember.FullName" />

                            <label>Specialisering</label>
                            <InputText class="settings-input" @bind-Value="staffMember.Specialization" />

                            <label>Presentation</label>
                            <InputTextArea class="settings-input settings-textarea"
                                           rows="5"
                                           @bind-Value="staffMember.Bio" />
                        </div>

                        <div class="staff-form-section">
                            <h2>Kontakt</h2>

                            <div class="settings-two-cols">
                                <div>
                                    <label>E-post</label>
                                    <InputText class="settings-input" @bind-Value="staffMember.Email" />
                                </div>

                                <div>
                                    <label>Telefon</label>
                                    <InputText class="settings-input" @bind-Value="staffMember.Phone" />
                                </div>
                            </div>
                        </div>

                        <div class="staff-form-section">
                            <h2>Bild och sortering</h2>

                            <div class="staff-image-upload-section">
                                <label>Profilbild</label>

                                @if (!string.IsNullOrWhiteSpace(staffMember.ImageUrl))
                                {
                                    <div class="staff-upload-preview">
                                        <img src="@staffMember.ImageUrl" alt="@staffMember.FullName" />

                                        <button type="button"
                                                class="staff-remove-image-btn"
                                                @onclick="RemoveImage">
                                            Ta bort bild
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="staff-upload-empty">
                                        <span>@GetInitials()</span>

                                        <div>
                                            <strong>Ingen bild uppladdad</strong>
                                            <p>Ladda upp JPG, PNG eller WEBP</p>
                                        </div>
                                    </div>
                                }

                                <label class="staff-upload-box">
                                    <InputFile OnChange="UploadImage"
                                               accept="image/png,image/jpeg,image/webp"
                                               class="staff-upload-input" />

                                    <div class="staff-upload-content">
                                        <strong>Ladda upp bild</strong>
                                        <span>Klicka här eller välj en fil</span>
                                    </div>
                                </label>
                            </div>

                            <label>Sortering</label>
                            <InputNumber class="settings-input" @bind-Value="staffMember.SortOrder" />
                        </div>

                        <div class="staff-form-section">
                            <h2>Synlighet</h2>

                            <div class="settings-switch-grid">
                                <label class="settings-switch">
                                    <InputCheckbox @bind-Value="staffMember.AllowOnlineBookings" />
                                    <span>
                                        <strong>Onlinebokning</strong>
                                        <small>Kunder kan välja denna person vid bokning.</small>
                                    </span>
                                </label>

                                <label class="settings-switch">
                                    <InputCheckbox @bind-Value="staffMember.IsActive" />
                                    <span>
                                        <strong>Aktiv personal</strong>
                                        <small>Personen är aktiv i systemet.</small>
                                    </span>
                                </label>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="settings-alert error">@errorMessage</div>
                        }

                        @if (!string.IsNullOrWhiteSpace(successMessage))
                        {
                            <div class="settings-alert success">@successMessage</div>
                        }

                        <div class="settings-actions">
                            <button class="admin-primary-btn" type="submit" disabled="@isSaving">
                                @(isSaving ? "Sparar..." : "Spara ändringar")
                            </button>

                            <a class="admin-secondary-btn" href="/admin/businesses/@BusinessId/staff">
                                Avbryt
                            </a>
                        </div>
                    </EditForm>
                </section>

                <aside class="staff-preview-card">
                    <p class="admin-eyebrow">Förhandsvisning</p>

                    <div class="staff-preview-box">
                        <div class="staff-preview-image">
                            @if (!string.IsNullOrWhiteSpace(staffMember.ImageUrl))
                            {
                                <img src="@staffMember.ImageUrl" alt="@staffMember.FullName" />
                            }
                            else
                            {
                                <span>@GetInitials()</span>
                            }
                        </div>

                        <div class="staff-preview-content">
                            <div class="staff-preview-pills">
                                <span class="staff-status-pill @(staffMember.IsActive ? "active" : "inactive")">
                                    @(staffMember.IsActive ? "Aktiv" : "Inaktiv")
                                </span>

                                <span class="staff-online-pill @(staffMember.AllowOnlineBookings ? "online" : "hidden")">
                                    @(staffMember.AllowOnlineBookings ? "Onlinebokning" : "Dold")
                                </span>
                            </div>

                            <h2>@DisplayOrFallback(staffMember.FullName, "Personalens namn")</h2>
                            <p class="staff-preview-specialization">
                                @DisplayOrFallback(staffMember.Specialization, "Specialisering")
                            </p>

                            <p>
                                @DisplayOrFallback(staffMember.Bio, "Här visas en kort presentation av personen.")
                            </p>
                        </div>

                        <div class="staff-preview-meta">
                            <div>
                                <span>E-post</span>
                                <strong>@DisplayOrFallback(staffMember.Email, "Saknas")</strong>
                            </div>

                            <div>
                                <span>Telefon</span>
                                <strong>@DisplayOrFallback(staffMember.Phone, "Saknas")</strong>
                            </div>

                            <div>
                                <span>Uppdaterad</span>
                                <strong>@(staffMember.UpdatedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "Aldrig")</strong>
                            </div>
                        </div>
                    </div>
                </aside>

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private StaffMember? staffMember;
    private Business? business;
    private string? errorMessage;
    private string? successMessage;
    private bool isSaving;

    private const long MaxFileSize = 5 * 1024 * 1024;

    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        if (staffMember is null)
            return;

        errorMessage = null;

        var file = e.File;
        var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".webp" };
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (!allowedExtensions.Contains(extension))
        {
            errorMessage = "Endast JPG, PNG och WEBP är tillåtna.";
            return;
        }

        if (file.Size > MaxFileSize)
        {
            errorMessage = "Bilden måste vara mindre än 5 MB.";
            return;
        }

        var uploadFolder = Path.Combine(Environment.WebRootPath, "uploads", "staff");
        Directory.CreateDirectory(uploadFolder);

        var fileName = $"{Guid.NewGuid()}{extension}";
        var fullPath = Path.Combine(uploadFolder, fileName);
        var relativePath = $"/uploads/staff/{fileName}";

        await using var readStream = file.OpenReadStream(MaxFileSize);
        await using var writeStream = File.Create(fullPath);

        await readStream.CopyToAsync(writeStream);

        staffMember.ImageUrl = relativePath;
    }

    private void RemoveImage()
    {
        if (staffMember is not null)
        {
            staffMember.ImageUrl = null;
        }
    }
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (!Permissions.HasAccess || !Permissions.CanManageStaff)
            return;

        business = await Db.Businesses.FirstOrDefaultAsync(b => b.Id == BusinessId);

        if (business is null)
        {
            Navigation.NavigateTo("/admin/businesses");
            return;
        }

        staffMember = await Db.StaffMembers
            .FirstOrDefaultAsync(s => s.Id == Id && s.BusinessId == BusinessId);

        if (staffMember is null)
        {
            Navigation.NavigateTo($"/admin/businesses/{BusinessId}/staff");
            return;
        }
    }

    private async Task SaveAsync()
    {
        if (staffMember is null)
            return;

        errorMessage = null;
        successMessage = null;
        isSaving = true;

        NormalizeStaff();

        if (!ValidateStaff())
        {
            isSaving = false;
            return;
        }

        staffMember.UpdatedAt = DateTime.UtcNow;

        await Db.SaveChangesAsync();

        successMessage = "Personalprofilen har sparats.";
        isSaving = false;
    }

    private void NormalizeStaff()
    {
        if (staffMember is null)
            return;

        staffMember.FullName = staffMember.FullName.Trim();
        staffMember.Email = staffMember.Email?.Trim();
        staffMember.Phone = staffMember.Phone?.Trim();
        staffMember.Specialization = staffMember.Specialization?.Trim();
        staffMember.Bio = staffMember.Bio?.Trim();
        staffMember.ImageUrl = staffMember.ImageUrl?.Trim();
    }

    private bool ValidateStaff()
    {
        if (staffMember is null)
            return false;
            
        if (string.IsNullOrWhiteSpace(staffMember.FullName))
        {
            errorMessage = "Fullständigt namn krävs.";
            return false;
        }

        return true;
    }

    private string GetInitials()
    {
        if (staffMember is null || string.IsNullOrWhiteSpace(staffMember.FullName))
            return "EB";

        var parts = staffMember.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return staffMember.FullName[0].ToString().ToUpper();
    }

    private static string DisplayOrFallback(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }
}