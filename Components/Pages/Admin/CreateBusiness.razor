@page "/admin/businesses/create"

@using EasySystems.Bookings.Data
@using EasySystems.Bookings.Data.Entities
@using EasySystems.Bookings.Data.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext Db
@inject NavigationManager Navigation

@attribute [Authorize(Roles = AppRoles.PlatformSuperAdmin)]

<PageTitle>Create Business</PageTitle>

<AdminNavbar />

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Create Business</h1>
        <p class="text-muted mb-0">
            Create a new booking business with working hours and public settings.
        </p>
    </div>

    <a class="btn btn-outline-secondary"
       href="/admin/businesses">
        Back
    </a>
</div>

<EditForm Model="business" OnValidSubmit="CreateAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="mb-3">
                <label class="form-label">Business name</label>
                <InputText class="form-control" @bind-Value="business.Name" />
            </div>

            <div class="mb-3">
                <label class="form-label">Slug</label>
                <InputText class="form-control" @bind-Value="business.Slug" />
                <small class="text-muted">Example: lina-salon, stockholm-barber</small>
            </div>

            <div class="mb-3">
                <label class="form-label">Business type</label>
                <InputText class="form-control" @bind-Value="business.BusinessType" />
                <small class="text-muted">Example: Barber, Salon, Clinic</small>
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <InputTextArea class="form-control"
                               rows="4"
                               @bind-Value="business.Description" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Address</label>
                    <InputText class="form-control" @bind-Value="business.Address" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">City</label>
                    <InputText class="form-control" @bind-Value="business.City" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Phone</label>
                    <InputText class="form-control" @bind-Value="business.Phone" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="business.Email" />
                </div>
            </div>

            <hr />

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Opening time</label>
                    <InputText type="time"
                               class="form-control"
                               @bind-Value="openingTimeString" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Closing time</label>
                    <InputText type="time"
                               class="form-control"
                               @bind-Value="closingTimeString" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Booking interval minutes</label>
                    <InputNumber class="form-control"
                                 @bind-Value="business.BookingIntervalMinutes" />
                    <small class="text-muted">Example: 15, 30, 60</small>
                </div>
            </div>

            <hr />

            <div class="mb-3">
                <label class="form-label">Logo URL</label>
                <InputText class="form-control" @bind-Value="business.LogoUrl" />
            </div>

            <div class="mb-3">
                <label class="form-label">Cover image URL</label>
                <InputText class="form-control" @bind-Value="business.CoverImageUrl" />
            </div>

            <div class="form-check mb-3">
                <InputCheckbox class="form-check-input"
                               @bind-Value="business.AllowOnlineBookings" />

                <label class="form-check-label">
                    Allow online bookings
                </label>
            </div>

            <div class="form-check mb-4">
                <InputCheckbox class="form-check-input"
                               @bind-Value="business.IsActive" />

                <label class="form-check-label">
                    Active
                </label>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }

            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-primary" type="submit">
                    Create Business
                </button>

                <a class="btn btn-outline-dark"
                   href="/admin/businesses">
                    Cancel
                </a>
            </div>

        </div>
    </div>
</EditForm>

@code {
    private Business business = new()
        {
            IsActive = true,
            AllowOnlineBookings = true,
            OpeningTime = new TimeSpan(9, 0, 0),
            ClosingTime = new TimeSpan(21, 0, 0),
            BookingIntervalMinutes = 15
        };

    private string? errorMessage;

    private string openingTimeString
    {
        get => business.OpeningTime.ToString(@"hh\:mm");
        set
        {
            if (TimeSpan.TryParse(value, out var time))
            {
                business.OpeningTime = time;
            }
        }
    }

    private string closingTimeString
    {
        get => business.ClosingTime.ToString(@"hh\:mm");
        set
        {
            if (TimeSpan.TryParse(value, out var time))
            {
                business.ClosingTime = time;
            }
        }
    }

    private async Task CreateAsync()
    {
        errorMessage = null;

        business.Name = business.Name.Trim();
        business.Slug = business.Slug.Trim().ToLower();

        if (string.IsNullOrWhiteSpace(business.Name))
        {
            errorMessage = "Business name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(business.Slug))
        {
            errorMessage = "Slug is required.";
            return;
        }

        if (business.ClosingTime <= business.OpeningTime)
        {
            errorMessage = "Closing time must be after opening time.";
            return;
        }

        if (business.BookingIntervalMinutes <= 0)
        {
            errorMessage = "Booking interval must be greater than 0.";
            return;
        }

        var slugExists = await Db.Businesses
            .AnyAsync(b => b.Slug == business.Slug);

        if (slugExists)
        {
            errorMessage = "This slug is already used by another business.";
            return;
        }

        business.CreatedAt = DateTime.UtcNow;

        Db.Businesses.Add(business);
        await Db.SaveChangesAsync();

        Navigation.NavigateTo($"/admin/businesses/{business.Id}/overview");
    }
}