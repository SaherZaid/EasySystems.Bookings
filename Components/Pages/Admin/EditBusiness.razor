@page "/admin/businesses/edit/{BusinessId:int}"
@rendermode InteractiveServer

@using EasySystems.Bookings.Components.Admin
@using EasySystems.Bookings.Data
@using EasySystems.Bookings.Data.Entities
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using Microsoft.EntityFrameworkCore
@using System.IO

@inherits AdminBusinessPageBase

@inject ApplicationDbContext Db
@inject IWebHostEnvironment Environment

<PageTitle>Inställningar | EasySystems</PageTitle>

<AdminNavbar BusinessId="BusinessId" />

@if (!Permissions.HasAccess)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Kontrollerar åtkomst...</div>
        </div>
    </div>
}
else if (!Permissions.CanManageSettings)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-alert danger">
                Du har inte behörighet att ändra verksamhetens inställningar.
            </div>
        </div>
    </div>
}
else if (business is null)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Laddar inställningar...</div>
        </div>
    </div>
}
else
{
    <div class="admin-page business-settings-page">
        <div class="admin-shell">

            <section class="admin-hero">
                <div>
                    <p class="admin-eyebrow">Inställningar</p>
                    <h1>@business.Name</h1>
                    <p>Uppdatera profil, kontaktuppgifter, bokningsregler, öppettider, bilder och design.</p>
                </div>

                <div class="admin-hero-actions">
                    <a class="admin-secondary-btn" href="/admin/businesses/@BusinessId/overview">
                        Översikt
                    </a>
                </div>
            </section>

            <EditForm Model="business" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />

                <div class="business-settings-grid">

                    <section class="business-form-card">
                        <h2>Grundinformation</h2>

                        <label>Verksamhetens namn</label>
                        <InputText class="settings-input" @bind-Value="business.Name" />

                        <button type="button" class="settings-inline-btn" @onclick="GenerateSlug">
                            Uppdatera slug från namn
                        </button>

                        <label>URL / slug</label>
                        <InputText class="settings-input" @bind-Value="business.Slug" />

                        <label>Typ av verksamhet</label>
                        <InputText class="settings-input" @bind-Value="business.BusinessType" />

                        <label>Kort slogan</label>
                        <InputText class="settings-input" @bind-Value="business.Tagline" />

                        <label>Beskrivning</label>
                        <InputTextArea class="settings-input settings-textarea" @bind-Value="business.Description" />

                        <h2>Kontaktuppgifter</h2>

                        <div class="settings-two-cols">
                            <div>
                                <label>Telefon</label>
                                <InputText class="settings-input" @bind-Value="business.Phone" />
                            </div>

                            <div>
                                <label>E-post</label>
                                <InputText class="settings-input" @bind-Value="business.Email" />
                            </div>
                        </div>

                        <div class="settings-two-cols">
                            <div>
                                <label>Adress</label>
                                <InputText class="settings-input" @bind-Value="business.Address" />
                            </div>

                            <div>
                                <label>Stad</label>
                                <InputText class="settings-input" @bind-Value="business.City" />
                            </div>
                        </div>

                        <h2>Sociala länkar</h2>

                        <div class="settings-two-cols">
                            <div>
                                <label>Webbplats</label>
                                <InputText class="settings-input" @bind-Value="business.WebsiteUrl" />
                            </div>

                            <div>
                                <label>Instagram</label>
                                <InputText class="settings-input" @bind-Value="business.InstagramUrl" />
                            </div>
                        </div>

                        <div class="settings-two-cols">
                            <div>
                                <label>Facebook</label>
                                <InputText class="settings-input" @bind-Value="business.FacebookUrl" />
                            </div>

                            <div>
                                <label>TikTok</label>
                                <InputText class="settings-input" @bind-Value="business.TikTokUrl" />
                            </div>
                        </div>

                        <h2>Bokningsinställningar</h2>

                        <label>Bokningsintervall i minuter</label>
                        <InputNumber class="settings-input" @bind-Value="business.BookingIntervalMinutes" />

                        <div class="settings-switch-grid">
                            <label class="settings-switch">
                                <InputCheckbox @bind-Value="business.AllowOnlineBookings" />
                                <span>
                                    <strong>Onlinebokning</strong>
                                    <small>Kunder kan boka tider online.</small>
                                </span>
                            </label>

                            <label class="settings-switch">
                                <InputCheckbox @bind-Value="business.IsActive" />
                                <span>
                                    <strong>Aktiv verksamhet</strong>
                                    <small>Verksamheten är synlig och aktiv.</small>
                                </span>
                            </label>
                        </div>

                        <h2>Öppettider per dag</h2>
                        <small>Välj vilka dagar verksamheten är öppen och ändra tiderna precis som du vill.</small>

                        <div class="weekly-hours-list">
                            @foreach (var day in weeklyHours)
                            {
                                <div class="weekly-hours-row @(day.IsOpen ? "is-open" : "is-closed")">
                                    <label class="weekly-day-toggle">
                                        <InputCheckbox @bind-Value="day.IsOpen" />
                                        <span>
                                            <strong>@day.Label</strong>
                                            <small>@(day.IsOpen ? "Öppet" : "Stängt")</small>
                                        </span>
                                    </label>

                                    <div class="weekly-time-inputs">
                                        <InputText type="time"
                                                   class="settings-input"
                                                   @bind-Value="day.OpenText"
                                                   disabled="@(!day.IsOpen)" />

                                        <span>till</span>

                                        <InputText type="time"
                                                   class="settings-input"
                                                   @bind-Value="day.CloseText"
                                                   disabled="@(!day.IsOpen)" />
                                    </div>
                                </div>
                            }
                        </div>

                        <h2>Bilder</h2>

                        <div class="settings-image-grid">
                            <div class="settings-image-card">
                                <label>Logotyp</label>

                                @if (!string.IsNullOrWhiteSpace(business.LogoUrl))
                                {
                                    <div class="settings-logo-preview">
                                        <img src="@business.LogoUrl" alt="Logotyp" />
                                    </div>

                                    <button type="button" class="settings-danger-btn" @onclick="RemoveLogo">
                                        Ta bort logotyp
                                    </button>
                                }
                                else
                                {
                                    <div class="settings-empty-image">Ingen logotyp vald</div>
                                }

                                <InputFile class="settings-file" OnChange="UploadLogo" accept="image/png,image/jpeg,image/webp" />
                            </div>

                            <div class="settings-image-card">
                                <label>Omslagsbild</label>

                                @if (!string.IsNullOrWhiteSpace(business.CoverImageUrl))
                                {
                                    <div class="settings-cover-preview">
                                        <img src="@business.CoverImageUrl" alt="Omslagsbild" />
                                    </div>

                                    <button type="button" class="settings-danger-btn" @onclick="RemoveCover">
                                        Ta bort omslagsbild
                                    </button>
                                }
                                else
                                {
                                    <div class="settings-empty-image">Ingen omslagsbild vald</div>
                                }

                                <InputFile class="settings-file" OnChange="UploadCover" accept="image/png,image/jpeg,image/webp" />
                            </div>
                        </div>

                        <h2>Designfärger</h2>

                        <div class="settings-color-grid">
                            <ColorInput Label="Huvudfärg" @bind-Value="business.PrimaryColor" />
                            <ColorInput Label="Sekundär färg" @bind-Value="business.SecondaryColor" />
                            <ColorInput Label="Sidbakgrund" @bind-Value="business.PageBackgroundColor" />
                            <ColorInput Label="Sektionsbakgrund" @bind-Value="business.SectionBackgroundColor" />
                            <ColorInput Label="Kortbakgrund" @bind-Value="business.CardBackgroundColor" />
                            <ColorInput Label="Rubriker" @bind-Value="business.HeadingTextColor" />
                            <ColorInput Label="Text" @bind-Value="business.BodyTextColor" />
                            <ColorInput Label="Diskret text" @bind-Value="business.MutedTextColor" />
                            <ColorInput Label="Huvudknapp" @bind-Value="business.ButtonBackgroundColor" />
                            <ColorInput Label="Huvudknapp text" @bind-Value="business.ButtonTextColor" />
                            <ColorInput Label="Sekundär knapp" @bind-Value="business.SecondaryButtonBackgroundColor" />
                            <ColorInput Label="Sekundär knapp text" @bind-Value="business.SecondaryButtonTextColor" />
                            <ColorInput Label="Toppmeny bakgrund" @bind-Value="business.NavbarBackgroundColor" />
                            <ColorInput Label="Toppmeny text" @bind-Value="business.NavbarTextColor" />
                            <ColorInput Label="Sidfot bakgrund" @bind-Value="business.FooterBackgroundColor" />
                            <ColorInput Label="Sidfot text" @bind-Value="business.FooterTextColor" />
                            <ColorInput Label="Hero-text" @bind-Value="business.HeroTextColor" />
                            <ColorInput Label="Tjänstekort" @bind-Value="business.ServiceCardBackgroundColor" />
                            <ColorInput Label="Personalkort" @bind-Value="business.StaffCardBackgroundColor" />
                            <ColorInput Label="Bokningspanel" @bind-Value="business.BookingPanelBackgroundColor" />
                            <ColorInput Label="Prisfärg" @bind-Value="business.PriceTextColor" />
                            <ColorInput Label="Success" @bind-Value="business.SuccessColor" />
                            <ColorInput Label="Varning" @bind-Value="business.WarningColor" />
                            <ColorInput Label="Fara" @bind-Value="business.DangerColor" />
                        </div>

                        <label>Mörkt lager över omslagsbild</label>
                        <InputText class="settings-input" @bind-Value="business.HeroOverlayColor" placeholder="rgba(0,0,0,.55)" />

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="settings-alert error">@errorMessage</div>
                        }

                        @if (!string.IsNullOrWhiteSpace(successMessage))
                        {
                            <div class="settings-alert success">@successMessage</div>
                        }

                        <div class="settings-actions">
                            <button class="admin-primary-btn" type="submit" disabled="@isSaving">
                                @(isSaving ? "Sparar..." : "Spara ändringar")
                            </button>

                            <a class="admin-secondary-btn" href="/admin/businesses/@BusinessId/overview">
                                Avbryt
                            </a>
                        </div>
                    </section>

                    <aside class="business-preview-card">
                        <p class="preview-label">Live preview</p>

                        <div class="booking-public-preview" style="@GetPreviewStyle()">
                            <div class="preview-navbar" style="@GetNavbarStyle()">
                                <strong>@DisplayOrFallback(business.Name, "Verksamhet")</strong>
                                <span>Boka</span>
                                <span>Tjänster</span>
                            </div>

                            <div class="preview-hero" style="@GetHeroStyle()">
                                <div class="preview-logo">
                                    @if (!string.IsNullOrWhiteSpace(business.LogoUrl))
                                    {
                                        <img src="@business.LogoUrl" alt="Logotyp" />
                                    }
                                    else
                                    {
                                        <span>@GetInitials()</span>
                                    }
                                </div>

                                <h2>@DisplayOrFallback(business.Name, "Verksamhetens namn")</h2>
                                <p>@DisplayOrFallback(business.Tagline, "En modern bokningsupplevelse för dina kunder.")</p>

                                <div class="preview-button-row">
                                    <button type="button" style="@GetButtonStyle()">Boka tid</button>
                                    <button type="button" style="@GetSecondaryButtonStyle()">Läs mer</button>
                                </div>
                            </div>

                            <div class="preview-info" style="@GetSectionStyle()">
                                <span>@DisplayOrFallback(business.BusinessType, "Typ")</span>
                                <span>@DisplayOrFallback(business.City, "Stad")</span>
                                <span>@GetPreviewOpeningHours()</span>
                            </div>

                            <div class="preview-service-card" style="@GetServiceCardStyle()">
                                <strong style="@GetHeadingTextStyle()">Exempeltjänst</strong>
                                <p style="@GetBodyTextStyle()">Här visas hur en tjänst kan presenteras för kunden.</p>
                                <span class="preview-price" style="@GetPriceTextStyle()">499 kr</span>
                            </div>

                            <div class="preview-staff-card" style="@GetStaffCardStyle()">
                                <div class="preview-staff-avatar">LS</div>
                                <div>
                                    <strong style="@GetHeadingTextStyle()">Lina</strong>
                                    <p style="@GetMutedTextStyle()">Specialist</p>
                                </div>
                            </div>

                            <div class="preview-booking-panel" style="@GetBookingPanelStyle()">
                                <strong style="@GetHeadingTextStyle()">Bokningspanel</strong>
                                <p style="@GetBodyTextStyle()">Datum, tider och kundinformation visas här.</p>

                                <div class="preview-status-row">
                                    <span style="@GetSuccessStatusStyle()">Bekräftad</span>
                                    <span style="@GetWarningStatusStyle()">Väntar</span>
                                    <span style="@GetDangerStatusStyle()">Avbokad</span>
                                </div>
                            </div>

                            <div class="preview-footer" style="@GetFooterStyle()">
                                <strong>@business.Name</strong>
                                <span>Kontakt · Villkor · Bokningar</span>
                            </div>
                        </div>

                        <div class="settings-preview-actions">
                            <button type="button" @onclick="ViewPublicPage">Visa sida</button>
                            <button type="button" @onclick="BackToOverview">Översikt</button>
                        </div>
                    </aside>

                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private Business? business;
    private string? errorMessage;
    private string? successMessage;
    private bool isSaving;
    private List<WeeklyHoursModel> weeklyHours = [];

    private const long MaxFileSize = 5 * 1024 * 1024;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (!Permissions.HasAccess || !Permissions.CanManageSettings)
            return;

        business = await Db.Businesses.FirstOrDefaultAsync(b => b.Id == BusinessId);

        if (business is null)
        {
            Navigation.NavigateTo("/admin/businesses");
            return;
        }

        ApplyDefaultDesignValues();
        LoadWeeklyHoursFromBusiness();
    }

    private async Task SaveAsync()
    {
        if (business is null)
            return;

        isSaving = true;
        errorMessage = null;
        successMessage = null;

        business.Name = business.Name.Trim();
        business.Slug = NormalizeSlug(business.Slug);

        ApplyDefaultDesignValues();

        if (!ApplyWeeklyHoursToBusiness())
        {
            isSaving = false;
            return;
        }

        if (!ValidateBusiness())
        {
            isSaving = false;
            return;
        }

        var slugExists = await Db.Businesses.AnyAsync(b => b.Id != BusinessId && b.Slug == business.Slug);

        if (slugExists)
        {
            errorMessage = "Denna URL används redan av en annan verksamhet.";
            isSaving = false;
            return;
        }

        await Db.SaveChangesAsync();

        successMessage = "Inställningarna har sparats.";
        isSaving = false;
    }

    private bool ValidateBusiness()
    {
        if (business is null)
            return false;

        if (string.IsNullOrWhiteSpace(business.Name))
        {
            errorMessage = "Verksamhetens namn krävs.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(business.Slug))
        {
            errorMessage = "URL / slug krävs.";
            return false;
        }

        if (business.BookingIntervalMinutes <= 0)
        {
            errorMessage = "Bokningsintervallet måste vara större än 0.";
            return false;
        }

        if (!weeklyHours.Any(x => x.IsOpen))
        {
            errorMessage = "Minst en dag måste vara öppen.";
            return false;
        }

        return true;
    }

    private bool ApplyWeeklyHoursToBusiness()
    {
        if (business is null)
            return false;

        foreach (var day in weeklyHours.Where(x => x.IsOpen))
        {
            if (!TimeSpan.TryParse(day.OpenText, out var openTime))
            {
                errorMessage = $"Öppningstiden för {day.Label} är ogiltig.";
                return false;
            }

            if (!TimeSpan.TryParse(day.CloseText, out var closeTime))
            {
                errorMessage = $"Stängningstiden för {day.Label} är ogiltig.";
                return false;
            }

            if (closeTime <= openTime)
            {
                errorMessage = $"Stängningstiden måste vara efter öppningstiden för {day.Label}.";
                return false;
            }

            day.Open = openTime;
            day.Close = closeTime;
        }

        foreach (var day in weeklyHours)
            SetDayHours(day);

        var firstOpenDay = weeklyHours.FirstOrDefault(x => x.IsOpen);

        if (firstOpenDay is not null)
        {
            business.OpeningTime = firstOpenDay.Open;
            business.ClosingTime = firstOpenDay.Close;
        }

        return true;
    }

    private void LoadWeeklyHoursFromBusiness()
    {
        if (business is null)
            return;

        weeklyHours =
        [
            new("Måndag", DayOfWeek.Monday, business.MondayIsOpen, business.MondayOpeningTime, business.MondayClosingTime),
        new("Tisdag", DayOfWeek.Tuesday, business.TuesdayIsOpen, business.TuesdayOpeningTime, business.TuesdayClosingTime),
        new("Onsdag", DayOfWeek.Wednesday, business.WednesdayIsOpen, business.WednesdayOpeningTime, business.WednesdayClosingTime),
        new("Torsdag", DayOfWeek.Thursday, business.ThursdayIsOpen, business.ThursdayOpeningTime, business.ThursdayClosingTime),
        new("Fredag", DayOfWeek.Friday, business.FridayIsOpen, business.FridayOpeningTime, business.FridayClosingTime),
        new("Lördag", DayOfWeek.Saturday, business.SaturdayIsOpen, business.SaturdayOpeningTime, business.SaturdayClosingTime),
        new("Söndag", DayOfWeek.Sunday, business.SundayIsOpen, business.SundayOpeningTime, business.SundayClosingTime)
        ];
    }

    private void SetDayHours(WeeklyHoursModel day)
    {
        if (business is null)
            return;

        switch (day.Day)
        {
            case DayOfWeek.Monday:
                business.MondayIsOpen = day.IsOpen;
                business.MondayOpeningTime = day.Open;
                business.MondayClosingTime = day.Close;
                break;
            case DayOfWeek.Tuesday:
                business.TuesdayIsOpen = day.IsOpen;
                business.TuesdayOpeningTime = day.Open;
                business.TuesdayClosingTime = day.Close;
                break;
            case DayOfWeek.Wednesday:
                business.WednesdayIsOpen = day.IsOpen;
                business.WednesdayOpeningTime = day.Open;
                business.WednesdayClosingTime = day.Close;
                break;
            case DayOfWeek.Thursday:
                business.ThursdayIsOpen = day.IsOpen;
                business.ThursdayOpeningTime = day.Open;
                business.ThursdayClosingTime = day.Close;
                break;
            case DayOfWeek.Friday:
                business.FridayIsOpen = day.IsOpen;
                business.FridayOpeningTime = day.Open;
                business.FridayClosingTime = day.Close;
                break;
            case DayOfWeek.Saturday:
                business.SaturdayIsOpen = day.IsOpen;
                business.SaturdayOpeningTime = day.Open;
                business.SaturdayClosingTime = day.Close;
                break;
            case DayOfWeek.Sunday:
                business.SundayIsOpen = day.IsOpen;
                business.SundayOpeningTime = day.Open;
                business.SundayClosingTime = day.Close;
                break;
        }
    }

    private void GenerateSlug()
    {
        if (business is not null)
            business.Slug = NormalizeSlug(business.Name);
    }

    private async Task UploadLogo(InputFileChangeEventArgs e)
    {
        if (business is null)
            return;

        business.LogoUrl = await SaveImageAsync(e.File, "logos");
    }

    private async Task UploadCover(InputFileChangeEventArgs e)
    {
        if (business is null)
            return;

        business.CoverImageUrl = await SaveImageAsync(e.File, "covers");
    }

    private async Task<string> SaveImageAsync(IBrowserFile file, string folderName)
    {
        errorMessage = null;

        var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".webp" };
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (!allowedExtensions.Contains(extension))
        {
            errorMessage = "Endast JPG, PNG och WEBP är tillåtna.";
            return "";
        }

        if (file.Size > MaxFileSize)
        {
            errorMessage = "Bilden måste vara mindre än 5 MB.";
            return "";
        }

        var uploadFolder = Path.Combine(Environment.WebRootPath, "uploads", "businesses", folderName);
        Directory.CreateDirectory(uploadFolder);

        var fileName = $"{Guid.NewGuid()}{extension}";
        var fullPath = Path.Combine(uploadFolder, fileName);
        var relativePath = $"/uploads/businesses/{folderName}/{fileName}";

        await using var readStream = file.OpenReadStream(MaxFileSize);
        await using var writeStream = File.Create(fullPath);
        await readStream.CopyToAsync(writeStream);

        successMessage = "Bilden har laddats upp. Kom ihåg att spara ändringarna.";

        return relativePath;
    }

    private void RemoveLogo()
    {
        if (business is not null)
            business.LogoUrl = null;
    }

    private void RemoveCover()
    {
        if (business is not null)
            business.CoverImageUrl = null;
    }

    private void ApplyDefaultDesignValues()
    {
        if (business is null)
            return;

        business.PrimaryColor = CssValue(business.PrimaryColor, "#151515");
        business.SecondaryColor = CssValue(business.SecondaryColor, "#C9A46A");
        business.PageBackgroundColor = CssValue(business.PageBackgroundColor, "#F8F4ED");
        business.SectionBackgroundColor = CssValue(business.SectionBackgroundColor, "#FFFFFF");
        business.CardBackgroundColor = CssValue(business.CardBackgroundColor, "#FFFFFF");
        business.HeadingTextColor = CssValue(business.HeadingTextColor, "#151515");
        business.BodyTextColor = CssValue(business.BodyTextColor, "#4B5563");
        business.MutedTextColor = CssValue(business.MutedTextColor, "#7A6F63");
        business.ButtonBackgroundColor = CssValue(business.ButtonBackgroundColor, "#151515");
        business.ButtonTextColor = CssValue(business.ButtonTextColor, "#FFFFFF");
        business.SecondaryButtonBackgroundColor = CssValue(business.SecondaryButtonBackgroundColor, "#FFFFFF");
        business.SecondaryButtonTextColor = CssValue(business.SecondaryButtonTextColor, "#151515");
        business.NavbarBackgroundColor = CssValue(business.NavbarBackgroundColor, "#FFFFFF");
        business.NavbarTextColor = CssValue(business.NavbarTextColor, "#151515");
        business.FooterBackgroundColor = CssValue(business.FooterBackgroundColor, "#151515");
        business.FooterTextColor = CssValue(business.FooterTextColor, "#FFFFFF");
        business.HeroTextColor = CssValue(business.HeroTextColor, "#FFFFFF");
        business.HeroOverlayColor = CssValue(business.HeroOverlayColor, "rgba(0,0,0,.55)");
        business.ServiceCardBackgroundColor = CssValue(business.ServiceCardBackgroundColor, "#FFFFFF");
        business.PriceTextColor = CssValue(business.PriceTextColor, "#151515");
        business.StaffCardBackgroundColor = CssValue(business.StaffCardBackgroundColor, "#FFFFFF");
        business.BookingPanelBackgroundColor = CssValue(business.BookingPanelBackgroundColor, "#FFFFFF");
        business.SuccessColor = CssValue(business.SuccessColor, "#087443");
        business.WarningColor = CssValue(business.WarningColor, "#B45309");
        business.DangerColor = CssValue(business.DangerColor, "#B42318");
    }

    private static string CssValue(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string NormalizeSlug(string value)
    {
        return (value ?? "")
            .Trim()
            .ToLower()
            .Replace(" ", "-")
            .Replace("å", "a")
            .Replace("ä", "a")
            .Replace("ö", "o");
    }

    private string DisplayOrFallback(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    private string GetInitials()
    {
        if (business is null || string.IsNullOrWhiteSpace(business.Name))
            return "EB";

        var parts = business.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return business.Name[0].ToString().ToUpper();
    }

    private string GetPreviewOpeningHours()
    {
        var first = weeklyHours.FirstOrDefault(x => x.IsOpen);

        if (first is null)
            return "Stängt";

        return $"{first.Label[..3]} {first.OpenText}-{first.CloseText}";
    }

    private string GetPreviewStyle() =>
        business is null ? "" : $"background-color:{CssValue(business.PageBackgroundColor, "#F8F4ED")}; color:{CssValue(business.BodyTextColor, "#4B5563")};";

    private string GetNavbarStyle() =>
        business is null ? "" : $"background-color:{CssValue(business.NavbarBackgroundColor, "#FFFFFF")}; color:{CssValue(business.NavbarTextColor, "#151515")};";

    private string GetButtonStyle() =>
        business is null ? "" : $"background-color:{CssValue(business.ButtonBackgroundColor, "#151515")}; color:{CssValue(business.ButtonTextColor, "#FFFFFF")};";

    private string GetSecondaryButtonStyle() =>
        business is null ? "" : $"background-color:{CssValue(business.SecondaryButtonBackgroundColor, "#FFFFFF")}; color:{CssValue(business.SecondaryButtonTextColor, "#151515")};";

