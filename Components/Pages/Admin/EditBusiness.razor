    private sealed class WeeklyHoursModel
    {
        public WeeklyHoursModel(string label, DayOfWeek day, bool isOpen, TimeSpan open, TimeSpan close)
        {
            Label = label;
            Day = day;
            IsOpen = isOpen;
            Open = open;
            Close = close;
            OpenText = open.ToString(@"hh\:mm");
            CloseText = close.ToString(@"hh\:mm");
        }

        public string Label { get; set; }
        public DayOfWeek Day { get; set; }
        public bool IsOpen { get; set; }
        public TimeSpan Open { get; set; }
        public TimeSpan Close { get; set; }
        public string OpenText { get; set; }
        public string CloseText { get; set; }
    }
