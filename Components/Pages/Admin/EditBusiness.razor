    private string GetHeroStyle()
    {
        if (business is null)
            return "";

        var heroTextColor = CssValue(business.HeroTextColor, "#FFFFFF");
        var primaryColor = CssValue(business.PrimaryColor, "#151515");
        var secondaryColor = CssValue(business.SecondaryColor, "#C9A46A");
        var overlay = CssValue(business.HeroOverlayColor, "rgba(0,0,0,.55)");

        if (string.IsNullOrWhiteSpace(business.CoverImageUrl))
        {
            return $"background-image:linear-gradient(135deg, {primaryColor}, {secondaryColor}); color:{heroTextColor};";
        }

        return $"background-image:linear-gradient({overlay}, {overlay}), url('{business.CoverImageUrl}'); background-position:center; background-size:cover; color:{heroTextColor};";
    }

