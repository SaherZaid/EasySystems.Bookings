@page "/admin/businesses/edit/{BusinessId:int}"

@using EasySystems.Bookings.Components.Admin
@using EasySystems.Bookings.Data
@using EasySystems.Bookings.Data.Entities
@using Microsoft.EntityFrameworkCore

@inherits AdminBusinessPageBase

@inject ApplicationDbContext Db

<PageTitle>Business Settings</PageTitle>

<AdminNavbar BusinessId="BusinessId" />

@if (!Permissions.HasAccess)
{
    <p>Checking access...</p>
}
else if (!Permissions.CanManageSettings)
{
    <div class="alert alert-danger">
        You do not have permission to manage business settings.
    </div>
}
else if (business is null)
{
    <p>Loading...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Business Settings</h1>

            <p class="text-muted mb-0">
                Manage profile, contact details, working hours, and booking settings.
            </p>
        </div>

        <a class="btn btn-outline-secondary"
           href="/admin/businesses/@BusinessId/overview">
            Back
        </a>

    </div>

    <EditForm Model="business" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card shadow-sm border-0">
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">Business name</label>
                    <InputText class="form-control" @bind-Value="business.Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Slug</label>
                    <InputText class="form-control" @bind-Value="business.Slug" />
                    <small class="text-muted">Example: lina-salon, stockholm-barber</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">Business type</label>
                    <InputText class="form-control" @bind-Value="business.BusinessType" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control"
                                   rows="4"
                                   @bind-Value="business.Description" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Address</label>
                        <InputText class="form-control" @bind-Value="business.Address" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">City</label>
                        <InputText class="form-control" @bind-Value="business.City" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone</label>
                        <InputText class="form-control" @bind-Value="business.Phone" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="business.Email" />
                    </div>
                </div>

                <hr />

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Opening time</label>
                        <InputText type="time"
                                   class="form-control"
                                   @bind-Value="openingTimeString" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Closing time</label>
                        <InputText type="time"
                                   class="form-control"
                                   @bind-Value="closingTimeString" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Booking interval minutes</label>
                        <InputNumber class="form-control"
                                     @bind-Value="business.BookingIntervalMinutes" />
                        <small class="text-muted">Example: 15, 30, 60</small>
                    </div>
                </div>

                <div class="alert alert-info">
                    Working hours:
                    <strong>@business.OpeningTime.ToString(@"hh\:mm")</strong>
                    →
                    <strong>@business.ClosingTime.ToString(@"hh\:mm")</strong>
                </div>

                <hr />

                <div class="mb-3">
                    <label class="form-label">Logo URL</label>
                    <InputText class="form-control" @bind-Value="business.LogoUrl" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Cover image URL</label>
                    <InputText class="form-control" @bind-Value="business.CoverImageUrl" />
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="business.AllowOnlineBookings" />

                    <label class="form-check-label">
                        Allow online bookings
                    </label>
                </div>

                <div class="form-check mb-4">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="business.IsActive" />

                    <label class="form-check-label">
                        Active
                    </label>
                </div>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger">
                        @errorMessage
                    </div>
                }

                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" type="submit">
                        Save Changes
                    </button>

                    <a class="btn btn-outline-dark"
                       href="/admin/businesses/@BusinessId/overview">
                        Cancel
                    </a>
                </div>

            </div>
        </div>
    </EditForm>
}

@code {
    private Business? business;

    private string? errorMessage;

    private string openingTimeString
    {
        get => business?.OpeningTime.ToString(@"hh\:mm") ?? "09:00";

        set
        {
            if (business is not null &&
                TimeSpan.TryParse(value, out var time))
            {
                business.OpeningTime = time;
            }
        }
    }

    private string closingTimeString
    {
        get => business?.ClosingTime.ToString(@"hh\:mm") ?? "21:00";

        set
        {
            if (business is not null &&
                TimeSpan.TryParse(value, out var time))
            {
                business.ClosingTime = time;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (!Permissions.HasAccess || !Permissions.CanManageSettings)
        {
            return;
        }

        business = await Db.Businesses
            .FirstOrDefaultAsync(b => b.Id == BusinessId);

        if (business is null)
        {
            Navigation.NavigateTo("/admin/businesses");
        }
    }

    private async Task SaveAsync()
    {
        errorMessage = null;

        if (business is null)
        {
            return;
        }

        business.Name = business.Name.Trim();
        business.Slug = business.Slug.Trim().ToLower();

        if (string.IsNullOrWhiteSpace(business.Name))
        {
            errorMessage = "Business name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(business.Slug))
        {
            errorMessage = "Slug is required.";
            return;
        }

        if (business.ClosingTime <= business.OpeningTime)
        {
            errorMessage = "Closing time must be after opening time.";
            return;
        }

        if (business.BookingIntervalMinutes <= 0)
        {
            errorMessage = "Booking interval must be greater than 0.";
            return;
        }

        var slugExists = await Db.Businesses
            .AnyAsync(b =>
                b.Id != BusinessId &&
                b.Slug == business.Slug);

        if (slugExists)
        {
            errorMessage = "This slug is already used by another business.";
            return;
        }

        await Db.SaveChangesAsync();

        Navigation.NavigateTo($"/admin/businesses/{BusinessId}/overview");
    }
}