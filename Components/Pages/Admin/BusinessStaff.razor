@page "/admin/businesses/{BusinessId:int}/staff"
@rendermode InteractiveServer

@using EasySystems.Bookings.Components.Admin
@using EasySystems.Bookings.Data
@using EasySystems.Bookings.Data.Entities
@using Microsoft.EntityFrameworkCore

@inherits AdminBusinessPageBase

@inject ApplicationDbContext Db

<PageTitle>Personal | EasySystems</PageTitle>

<AdminNavbar BusinessId="BusinessId" />

@if (!Permissions.HasAccess)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Kontrollerar åtkomst...</div>
        </div>
    </div>
}
else if (!Permissions.CanManageStaff)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-alert danger">
                Du har inte behörighet att hantera personal.
            </div>
        </div>
    </div>
}
else if (business is null)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Laddar personal...</div>
        </div>
    </div>
}
else
{
    <div class="admin-page admin-staff-page">
        <div class="admin-shell">

            <section class="admin-hero">
                <div>
                    <p class="admin-eyebrow">Personal</p>
                    <h1>@business.Name</h1>
                    <p>Hantera personal, specialiseringar, kontaktuppgifter och onlinebokning.</p>
                </div>

                <div class="admin-hero-actions">
                    <a class="admin-primary-btn" href="/admin/businesses/@BusinessId/staff/create">
                        + Lägg till personal
                    </a>
                </div>
            </section>

            <section class="staff-stats-grid">
                <div class="staff-stat-card">
                    <span>Totalt</span>
                    <strong>@staffMembers.Count</strong>
                </div>

                <div class="staff-stat-card">
                    <span>Aktiva</span>
                    <strong>@staffMembers.Count(x => x.IsActive)</strong>
                </div>

                <div class="staff-stat-card">
                    <span>Online</span>
                    <strong>@staffMembers.Count(x => x.AllowOnlineBookings)</strong>
                </div>

                <div class="staff-stat-card">
                    <span>Dolda</span>
                    <strong>@staffMembers.Count(x => !x.AllowOnlineBookings)</strong>
                </div>
            </section>

            @if (!staffMembers.Any())
            {
                <section class="admin-empty-state">
                    <h2>Ingen personal ännu</h2>
                    <p>Lägg till personal så att kunder kan välja vem de vill boka hos.</p>

                    <a class="admin-primary-btn" href="/admin/businesses/@BusinessId/staff/create">
                        Lägg till första personen
                    </a>
                </section>
            }
            else
            {
                <section class="staff-grid">
                    @foreach (var staff in staffMembers)
                    {
                        <article class="staff-list-card @(staff.IsActive ? "active" : "inactive")">
                            <div class="staff-card-visual">
                                @if (!string.IsNullOrWhiteSpace(staff.ImageUrl))
                                {
                                    <img src="@staff.ImageUrl" alt="@staff.FullName" />
                                }
                                else
                                {
                                    <span>@GetInitials(staff.FullName)</span>
                                }
                            </div>

                            <div class="staff-list-content">
                                <div class="staff-list-top">
                                    <span class="staff-status-pill @(staff.IsActive ? "active" : "inactive")">
                                        @(staff.IsActive ? "Aktiv" : "Inaktiv")
                                    </span>

                                    <span class="staff-online-pill @(staff.AllowOnlineBookings ? "online" : "hidden")">
                                        @(staff.AllowOnlineBookings ? "Onlinebokning" : "Dold")
                                    </span>
                                </div>

                                <h2>@staff.FullName</h2>

                                <p class="staff-specialization">
                                    @DisplayOrFallback(staff.Specialization, "Ingen specialisering")
                                </p>

                                @if (!string.IsNullOrWhiteSpace(staff.Bio))
                                {
                                    <p class="staff-bio">@staff.Bio</p>
                                }
                                else
                                {
                                    <p class="staff-bio muted">Ingen presentation tillagd.</p>
                                }

                                <div class="staff-contact-grid">
                                    <div>
                                        <span>E-post</span>
                                        <strong>@DisplayOrFallback(staff.Email, "Saknas")</strong>
                                    </div>

                                    <div>
                                        <span>Telefon</span>
                                        <strong>@DisplayOrFallback(staff.Phone, "Saknas")</strong>
                                    </div>
                                </div>

                                <div class="staff-list-actions">
                                    <a href="/admin/businesses/@BusinessId/staff/edit/@staff.Id">
                                        Redigera
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                </section>
            }
        </div>
    </div>
}

@code {
    private Business? business;
    private List<StaffMember> staffMembers = [];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (!Permissions.HasAccess || !Permissions.CanManageStaff)
            return;

        business = await Db.Businesses
            .FirstOrDefaultAsync(b => b.Id == BusinessId);

        if (business is null)
            return;

        staffMembers = await Db.StaffMembers
            .Where(s => s.BusinessId == BusinessId)
            .OrderBy(s => s.SortOrder)
            .ThenBy(s => s.FullName)
            .ToListAsync();
    }

    private static string DisplayOrFallback(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    private static string GetInitials(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "EB";

        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return value[0].ToString().ToUpper();
    }
}