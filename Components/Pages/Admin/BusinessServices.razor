@page "/admin/businesses/{BusinessId:int}/services"
@rendermode InteractiveServer

@using EasySystems.Bookings.Components.Admin
@using EasySystems.Bookings.Data
@using EasySystems.Bookings.Data.Entities
@using Microsoft.EntityFrameworkCore

@inherits AdminBusinessPageBase

@inject ApplicationDbContext Db

<PageTitle>Tjänster | EasySystems</PageTitle>

<AdminNavbar BusinessId="BusinessId" />

@if (!Permissions.HasAccess)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Kontrollerar åtkomst...</div>
        </div>
    </div>
}
else if (!Permissions.CanManageServices)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-alert danger">
                Du har inte behörighet att hantera tjänster.
            </div>
        </div>
    </div>
}
else if (business is null)
{
    <div class="admin-page">
        <div class="admin-shell">
            <div class="admin-loading-card">Laddar tjänster...</div>
        </div>
    </div>
}
else
{
    <div class="admin-page admin-services-page">
        <div class="admin-shell">

            <section class="admin-hero">
                <div>
                    <p class="admin-eyebrow">Tjänster</p>
                    <h1>@business.Name</h1>
                    <p>Hantera priser, tider, sortering och vilka tjänster som kunder kan boka.</p>
                </div>

                <div class="admin-hero-actions">
                    <a class="admin-primary-btn" href="/admin/businesses/@BusinessId/services/create">
                        + Skapa tjänst
                    </a>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="admin-alert success">@successMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="admin-alert danger">@errorMessage</div>
            }

            <section class="services-stats-grid">
                <div class="services-stat-card">
                    <span>Totalt</span>
                    <strong>@services.Count</strong>
                </div>

                <div class="services-stat-card">
                    <span>Aktiva</span>
                    <strong>@services.Count(x => x.IsActive)</strong>
                </div>

                <div class="services-stat-card">
                    <span>Inaktiva</span>
                    <strong>@services.Count(x => !x.IsActive)</strong>
                </div>

                <div class="services-stat-card">
                    <span>Snittid</span>
                    <strong>@GetAverageDuration() min</strong>
                </div>
            </section>

            @if (!services.Any())
            {
                <section class="admin-empty-state">
                    <h2>Inga tjänster ännu</h2>
                    <p>Skapa din första tjänst så att kunder kan boka tider online.</p>

                    <a class="admin-primary-btn" href="/admin/businesses/@BusinessId/services/create">
                        Skapa första tjänsten
                    </a>
                </section>
            }
            else
            {
                <section class="services-grid">
                    @foreach (var service in services)
                    {
                        <article class="service-list-card @(service.IsActive ? "active" : "inactive")">
                            <div class="service-list-card-top">
                                <span class="service-status-pill @(service.IsActive ? "active" : "inactive")">
                                    @(service.IsActive ? "Aktiv" : "Inaktiv")
                                </span>

                                <span class="service-sort-pill">
                                    Sortering @service.SortOrder
                                </span>
                            </div>

                            <h2>@service.Name</h2>

                            @if (!string.IsNullOrWhiteSpace(service.Description))
                            {
                                <p>@service.Description</p>
                            }
                            else
                            {
                                <p class="muted">Ingen beskrivning tillagd.</p>
                            }

                            <div class="service-list-meta">
                                <div>
                                    <span>Tid</span>
                                    <strong>@service.DurationMinutes min</strong>
                                </div>

                                <div>
                                    <span>Pris</span>
                                    <strong>@service.Price.ToString("0.00") kr</strong>
                                </div>

                                <div>
                                    <span>Skapad</span>
                                    <strong>@service.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</strong>
                                </div>
                            </div>

                            <div class="service-list-actions">
                                <a href="/admin/businesses/@BusinessId/services/edit/@service.Id">
                                    Redigera
                                </a>

                                <button type="button"
                                        class="service-delete-btn"
                                        @onclick="() => OpenDeleteModal(service)">
                                    Ta bort
                                </button>
                            </div>
                        </article>
                    }
                </section>
            }
        </div>
    </div>
}

@if (serviceToDelete is not null)
{
    <div class="delete-modal-backdrop">
        <div class="delete-modal">
            <div class="delete-modal-icon">!</div>

            <h2>Ta bort tjänst?</h2>

            <p>
                Är du säker på att du vill ta bort
                <strong>@serviceToDelete.Name</strong>?
            </p>

            <p class="delete-modal-warning">
                Detta går inte att ångra. Om tjänsten har bokningar kopplade till sig kan den inte tas bort.
            </p>

            <div class="delete-modal-actions">
                <button type="button"
                        class="admin-secondary-btn"
                        @onclick="CloseDeleteModal"
                        disabled="@isDeleting">
                    Avbryt
                </button>

                <button type="button"
                        class="delete-confirm-btn"
                        @onclick="ConfirmDeleteAsync"
                        disabled="@isDeleting">
                    @(isDeleting ? "Tar bort..." : "Ja, ta bort")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private Business? business;
    private List<Service> services = [];

    private Service? serviceToDelete;
    private bool isDeleting;

    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (!Permissions.HasAccess || !Permissions.CanManageServices)
            return;

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        business = await Db.Businesses
            .FirstOrDefaultAsync(b => b.Id == BusinessId);

        if (business is null)
            return;

        services = await Db.Services
            .Where(s => s.BusinessId == BusinessId)
            .OrderBy(s => s.SortOrder)
            .ThenBy(s => s.Name)
            .ToListAsync();
    }

    private void OpenDeleteModal(Service service)
    {
        successMessage = null;
        errorMessage = null;
        serviceToDelete = service;
    }

    private void CloseDeleteModal()
    {
        if (isDeleting)
            return;

        serviceToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (serviceToDelete is null)
            return;

        isDeleting = true;
        successMessage = null;
        errorMessage = null;

        try
        {
            var serviceId = serviceToDelete.Id;
            var serviceName = serviceToDelete.Name;

            var hasBookings = await Db.Bookings
                .AnyAsync(b => b.BusinessId == BusinessId && b.ServiceId == serviceId);

            if (hasBookings)
            {
                errorMessage = $"Det går inte att ta bort {serviceName} eftersom tjänsten har bokningar kopplade till sig. Gör tjänsten inaktiv istället.";
                serviceToDelete = null;
                return;
            }

            var service = await Db.Services
                .FirstOrDefaultAsync(s => s.Id == serviceId && s.BusinessId == BusinessId);

            if (service is null)
            {
                errorMessage = "Tjänsten kunde inte hittas.";
                serviceToDelete = null;
                return;
            }

            Db.Services.Remove(service);
            await Db.SaveChangesAsync();

            services.RemoveAll(s => s.Id == serviceId);

            successMessage = $"{serviceName} har tagits bort.";
            serviceToDelete = null;
        }
        catch
        {
            errorMessage = "Något gick fel när tjänsten skulle tas bort.";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private int GetAverageDuration()
    {
        if (!services.Any())
            return 0;

        return (int)Math.Round(services.Average(x => x.DurationMinutes));
    }
}