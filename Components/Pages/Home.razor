@page "/"
@rendermode InteractiveServer

@using EasySystems.Bookings.Data
@using EasySystems.Bookings.Data.Entities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Globalization

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>@pageTitle</PageTitle>

<PublicNavbar />

@if (!isLoading && business is null)
{
    <div class="public-booking-page">
        <div class="public-empty-state">
            <h1>Ingen bokningssida hittades</h1>
            <p>Verksamheten är inte aktiv eller tar inte emot onlinebokningar just nu.</p>
        </div>
    </div>
}
else
{
    <div class="public-booking-page home-landing-page" style="@GetPublicThemeStyle()">

        <section class="public-booking-hero home-landing-hero" style="@GetHeroStyle()">
            <div class="public-booking-hero-content">

                @if (isLoading)
                {
                    <div class="public-booking-logo-fallback">EB</div>
                    <span class="public-booking-pill">Bokning online</span>
                    <h1>EasyBookings</h1>
                    <p class="public-booking-tagline">Laddar sidan...</p>
                }
                else if (business is not null)
                {
                    @if (!string.IsNullOrWhiteSpace(business.LogoUrl))
                    {
                        <img class="public-booking-logo" src="@business.LogoUrl" alt="@business.Name" />
                    }
                    else
                    {
                        <div class="public-booking-logo-fallback">@GetInitials()</div>
                    }

                    <span class="public-booking-pill">
                        @DisplayOrFallback(business.BusinessType, "Bokning online")
                    </span>

                    <h1>@business.Name</h1>

                    <p class="public-booking-tagline">
                        @DisplayOrFallback(
                                 business.Tagline,
                                 business.Description ?? "Boka din tid enkelt online.")
                    </p>
                }

                <div class="public-booking-hero-actions">
                    <a href="/booking" class="public-primary-link">Boka ny tid</a>
                    <a href="/services" class="public-booking-light-btn">Se tjänster</a>

                    @if (currentUser is not null)
                    {
                        <a href="/Account/Bookings" class="public-booking-light-btn">Mina bokningar</a>
                    }
                    else
                    {
                        <a href="/Account/Login" class="public-booking-light-btn">Logga in</a>
                    }
                </div>
            </div>
        </section>

        <main class="public-booking-shell home-landing-shell">

            

            <section class="home-section">
                <div class="public-section-header home-centered-header">
                    <p>Så fungerar det</p>
                    <h2>Boka på några sekunder</h2>
                </div>

                <div class="home-feature-grid">
                    <article class="home-feature-card">
                        <span>1</span>
                        <h3>Välj tjänst</h3>
                        <p>Se vilka tjänster som finns tillgängliga och välj det som passar dig bäst.</p>
                    </article>

                    <article class="home-feature-card">
                        <span>2</span>
                        <h3>Välj tid</h3>
                        <p>Hitta en ledig tid direkt online baserat på öppettider och personal.</p>
                    </article>

                    <article class="home-feature-card">
                        <span>3</span>
                        <h3>Skicka bokning</h3>
                        <p>Skicka din bokningsförfrågan och få detaljerna skickade till dig.</p>
                    </article>
                </div>
            </section>

            <section class="home-section">
                <div class="home-section-top">
                    <div class="public-section-header">
                        <p>Tjänster</p>
                        <h2>Populära tjänster</h2>
                    </div>

                    <a class="home-small-link" href="/services">Visa alla tjänster</a>
                </div>

                @if (isLoading)
                {
                    <div class="public-alert neutral">Laddar tjänster...</div>
                }
                else if (!services.Any())
                {
                    <div class="public-empty-state">
                        <h2>Inga tjänster tillgängliga</h2>
                        <p>Det finns inga aktiva tjänster just nu.</p>
                    </div>
                }
                else
                {
                    <div class="home-services-grid">
                        @foreach (var service in services.Take(6))
                        {
                            <article class="home-service-card">
                                <div>
                                    <h3>@service.Name</h3>

                                    @if (!string.IsNullOrWhiteSpace(service.Description))
                                    {
                                        <p>@service.Description</p>
                                    }
                                </div>

                                <div class="home-service-meta">
                                    <span>@service.DurationMinutes min</span>
                                    <strong>@service.Price.ToString("0.00") kr</strong>
                                </div>

                                <a href="/booking?serviceId=@service.Id">
                                    Boka
                                </a>
                            </article>
                        }
                    </div>
                }
            </section>

            

            @if (staffMembers.Any())
            {
                <section class="home-team-section">
                    <div class="public-section-header">
                        <p>Team</p>
                        <h2>Träffa vårt team</h2>
                    </div>

                    @if (isLoading)
                    {
                        <p>Laddar personal...</p>
                    }
                    else if (!staffMembers.Any())
                    {
                        <p>Ingen personal tillgänglig.</p>
                    }
                    else
                    {
                        <div class="home-team-grid">
                            @foreach (var staff in staffMembers)
                            {
                                <article class="home-team-card">
                                    @if (!string.IsNullOrWhiteSpace(staff.ImageUrl))
                                    {
                                        <img class="home-team-image" src="@staff.ImageUrl" alt="@staff.FullName" />
                                    }
                                    else
                                    {
                                        <div class="home-team-image-fallback">
                                            @GetStaffInitials(staff.FullName)
                                        </div>
                                    }

                                    <div class="home-team-content">
                                        <span>@(string.IsNullOrWhiteSpace(staff.Specialization) ? "Personal" : staff.Specialization)</span>
                                        <h3>@staff.FullName</h3>

                                        @if (!string.IsNullOrWhiteSpace(staff.Bio))
                                        {
                                            <p>@staff.Bio</p>
                                        }
                                        else
                                        {
                                            <p>Redo att hjälpa dig med din bokning.</p>
                                        }

                                        <a href="/booking?staffId=@staff.Id"
                                           class="home-team-btn">
                                            Boka tid
                                        </a>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>
            }

            <section class="home-premium-cta">
                <div class="home-premium-cta-content">
                    <span class="home-premium-kicker">Redo för nästa steg?</span>

                    <h2>Boka din nästa tid på ett enklare sätt</h2>

                    <p>
                        Välj tjänst, personal och en ledig tid direkt online utan krångel.
                    </p>
                </div>

                <div class="home-premium-cta-actions">
                    <a href="/booking" class="home-premium-primary-btn">
                        Boka tid nu
                    </a>

                    <a href="/services" class="home-premium-secondary-btn">
                        Se tjänster
                    </a>
                </div>
            </section>

        

            <section class="home-benefits-section">

                <div class="home-section-heading">
                    <span>Varför välja oss</span>
                    <h2>En smidigare bokningsupplevelse</h2>
                </div>

                <div class="home-benefits-grid">

                    <article class="home-benefit-card">
                        <h3>Onlinebokning 24/7</h3>
                        <p>Boka när som helst direkt från mobilen.</p>
                    </article>

                    <article class="home-benefit-card">
                        <h3>Professionell personal</h3>
                        <p>Erfaren personal som hjälper dig hela vägen.</p>
                    </article>

                    <article class="home-benefit-card">
                        <h3>Snabb bekräftelse</h3>
                        <p>Få bokningsinformation direkt via e-post.</p>
                    </article>

                </div>

            </section>

        </main>

        
    </div>
}

@code {
    private bool isLoading = true;

    private string pageTitle = "EasyBookings";

    private Business? business;
    private ApplicationUser? currentUser;

    private List<Service> services = [];
    private List<StaffMember> staffMembers = [];
    private List<PublicDayHoursModel> weeklyHours = [];

    private static readonly CultureInfo SwedishCulture = new("sv-SE");

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        await LoadCurrentUserAsync();

        await using var db = await DbFactory.CreateDbContextAsync();

        business = await db.Businesses
            .AsNoTracking()
            .FirstOrDefaultAsync(b => b.IsActive && b.AllowOnlineBookings);

        if (business is null)
        {
            pageTitle = "Bokningssida saknas";
            isLoading = false;
            return;
        }

        pageTitle = business.Name;

        LoadWeeklyHours();

        services = await db.Services
            .AsNoTracking()
            .Where(s => s.BusinessId == business.Id && s.IsActive)
            .OrderBy(s => s.SortOrder)
            .ThenBy(s => s.Name)
            .ToListAsync();

        staffMembers = await db.StaffMembers
            .AsNoTracking()
            .Where(s => s.BusinessId == business.Id && s.IsActive && s.AllowOnlineBookings)
            .OrderBy(s => s.SortOrder)
            .ThenBy(s => s.FullName)
            .ToListAsync();

        isLoading = false;
    }

    private async Task LoadCurrentUserAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        if (principal.Identity?.IsAuthenticated == true)
        {
            currentUser = await UserManager.GetUserAsync(principal);
        }
    }

    private void LoadWeeklyHours()
    {
        if (business is null)
            return;

        weeklyHours =
        [
            new("Måndag", DayOfWeek.Monday, business.MondayIsOpen, business.MondayOpeningTime, business.MondayClosingTime),
        new("Tisdag", DayOfWeek.Tuesday, business.TuesdayIsOpen, business.TuesdayOpeningTime, business.TuesdayClosingTime),
        new("Onsdag", DayOfWeek.Wednesday, business.WednesdayIsOpen, business.WednesdayOpeningTime, business.WednesdayClosingTime),
        new("Torsdag", DayOfWeek.Thursday, business.ThursdayIsOpen, business.ThursdayOpeningTime, business.ThursdayClosingTime),
        new("Fredag", DayOfWeek.Friday, business.FridayIsOpen, business.FridayOpeningTime, business.FridayClosingTime),
        new("Lördag", DayOfWeek.Saturday, business.SaturdayIsOpen, business.SaturdayOpeningTime, business.SaturdayClosingTime),
        new("Söndag", DayOfWeek.Sunday, business.SundayIsOpen, business.SundayOpeningTime, business.SundayClosingTime)
        ];
    }

    private string GetTodayHoursLabel()
    {
        var hours = weeklyHours.FirstOrDefault(x => x.Day == DateTime.Today.DayOfWeek);

        if (hours is null || !hours.IsOpen)
            return "Stängt idag";

        return $"{hours.Open:hh\\:mm} - {hours.Close:hh\\:mm}";
    }

    private string GetInitials()
    {
        if (business is null || string.IsNullOrWhiteSpace(business.Name))
            return "EB";

        var parts = business.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return business.Name[0].ToString().ToUpper();
    }

    private static string GetStaffInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "S";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return name[0].ToString().ToUpper();
    }

    private string GetPublicThemeStyle()
    {
        if (business is null)
            return "";

        return string.Join(" ",
            $"--public-page-bg:{CssValue(business.PageBackgroundColor, "#F8F4ED")};",
            $"--public-section-bg:{CssValue(business.SectionBackgroundColor, "#FFFFFF")};",
            $"--public-card-bg:{CssValue(business.CardBackgroundColor, "#FFFFFF")};",
            $"--public-service-card-bg:{CssValue(business.ServiceCardBackgroundColor, "#FFFFFF")};",
            $"--public-staff-card-bg:{CssValue(business.StaffCardBackgroundColor, "#FFFFFF")};",
            $"--public-booking-panel-bg:{CssValue(business.BookingPanelBackgroundColor, "#FFFFFF")};",
            $"--public-heading:{CssValue(business.HeadingTextColor, "#151515")};",
            $"--public-body:{CssValue(business.BodyTextColor, "#4B5563")};",
            $"--public-muted:{CssValue(business.MutedTextColor, "#7A6F63")};",
            $"--public-primary:{CssValue(business.PrimaryColor, "#151515")};",
            $"--public-secondary:{CssValue(business.SecondaryColor, "#C9A46A")};",
            $"--public-button-bg:{CssValue(business.ButtonBackgroundColor, "#151515")};",
            $"--public-button-text:{CssValue(business.ButtonTextColor, "#FFFFFF")};",
            $"--public-secondary-button-bg:{CssValue(business.SecondaryButtonBackgroundColor, "#FFFFFF")};",
            $"--public-secondary-button-text:{CssValue(business.SecondaryButtonTextColor, "#151515")};",
            $"--public-price:{CssValue(business.PriceTextColor, "#151515")};",
            $"--public-success:{CssValue(business.SuccessColor, "#087443")};",
            $"--public-warning:{CssValue(business.WarningColor, "#B45309")};",
            $"--public-danger:{CssValue(business.DangerColor, "#B42318")};",
            $"--public-input-bg:{CssValue(business.InputBackgroundColor, "#FFFFFF")};",
            $"--public-input-text:{CssValue(business.InputTextColor, "#151515")};",
            $"--public-input-border:{CssValue(business.InputBorderColor, "#E5E7EB")};",
            $"--public-input-focus:{CssValue(business.InputFocusColor, "#C9A46A")};",
            $"--public-label:{CssValue(business.LabelTextColor, "#374151")};",
            $"--public-time-bg:{CssValue(business.TimeSlotBackgroundColor, "#FFFFFF")};",
            $"--public-time-text:{CssValue(business.TimeSlotTextColor, "#151515")};",
            $"--public-time-active-bg:{CssValue(business.TimeSlotActiveBackgroundColor, "#151515")};",
            $"--public-time-active-text:{CssValue(business.TimeSlotActiveTextColor, "#FFFFFF")};",
            $"background-color:{CssValue(business.PageBackgroundColor, "#F8F4ED")};",
            $"color:{CssValue(business.BodyTextColor, "#4B5563")};"
        );
    }

    private string GetHeroStyle()
    {
        if (business is null)
            return "background-image:linear-gradient(135deg,#151515,#C9A46A); color:#FFFFFF;";

        var heroText = CssValue(business.HeroTextColor, "#FFFFFF");

        if (string.IsNullOrWhiteSpace(business.CoverImageUrl))
        {
            return $"background-image:linear-gradient(135deg,{CssValue(business.PrimaryColor, "#151515")},{CssValue(business.SecondaryColor, "#C9A46A")}); color:{heroText};";
        }

        var overlay = CssValue(business.HeroOverlayColor, "rgba(0,0,0,.55)");

        return $"background-image:linear-gradient({overlay},{overlay}), url('{business.CoverImageUrl}'); background-position:center; background-size:cover; color:{heroText};";
    }

    private static string DisplayOrFallback(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    private static string CssValue(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    private sealed class PublicDayHoursModel
    {
        public PublicDayHoursModel(string label, DayOfWeek day, bool isOpen, TimeSpan open, TimeSpan close)
        {
            Label = label;
            Day = day;
            IsOpen = isOpen;
            Open = open;
            Close = close;
        }

        public string Label { get; }
        public DayOfWeek Day { get; }
        public bool IsOpen { get; }
        public TimeSpan Open { get; }
        public TimeSpan Close { get; }
    }
}